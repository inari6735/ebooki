{% extends 'ebook/publish/layout.html.twig' %}

{% block flow_body %}
    {% set price = data.price ?: 29.99 %}
    {% set promo = data.promoPrice %}
    {% set noPrice = data.isFree or data.payWhatYouWant %}
    {% set discounted = not noPrice and promo and promo > 0 and promo < price %}
    {% set discountPct = discounted ? ((price - promo) / price * 100)|round : 0 %}
    {% set dimIfNoPrice = noPrice ? ' pointer-events-none opacity-50' : '' %}
    {% set effectiveText = data.isFree ? 'Za darmo' : (data.payWhatYouWant ? 'Dobrowolna wpłata' : (discounted ? promo : price)|number_format(2, ',', ' ') ~ ' zł') %}
    {% set effectiveColor = data.isFree ? 'text-success-600' : (data.payWhatYouWant ? 'text-accent-600' : 'text-zinc-900') %}
    {{ form_start(form, { attr: { id: 'wizard-form' } }) }}
    <div class="grid gap-6 lg:grid-cols-3" data-controller="price-calc">
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Ustaw cenę i sposób sprzedaży</h2>
            <p class="mt-1 text-sm text-zinc-500">Sam decydujesz, ile zarobisz. To proste i przejrzyste.</p>

            <div class="mt-5 grid gap-5 sm:grid-cols-2">
                <div class="rounded-2xl border border-zinc-200 p-5{{ dimIfNoPrice }}" data-price-calc-target="dim">
                    <label class="field-label" for="{{ form.price.vars.id }}">Cena eBooka (PLN)</label>
                    <div class="flex items-baseline gap-2">
                        {{ form_widget(form.price, { attr: {
                            class: 'w-full border-0 p-0 text-4xl font-extrabold text-zinc-900 outline-none',
                            step: '0.01', placeholder: '0,00',
                            'data-price-calc-target': 'price', 'data-action': 'input->price-calc#update',
                        } }) }}
                        <span class="text-lg font-semibold text-zinc-400">zł</span>
                    </div>
                    {{ form_errors(form.price) }}
                </div>
                <div class="flex items-start gap-3 rounded-2xl bg-accent-50 p-5{{ dimIfNoPrice }}" data-price-calc-target="dim">
                    <twig:Icon name="chart" class="mt-0.5 h-6 w-6 shrink-0 text-accent-600" />
                    <div>
                        <p class="font-semibold text-zinc-900">Twoje wynagrodzenie</p>
                        <p class="mt-1 text-sm text-zinc-600">Otrzymujesz 90% ceny eBooka</p>
                        <p class="text-xs text-zinc-400">Prowizja platformy: 10%</p>
                    </div>
                </div>
            </div>

            <div class="mt-5 sm:max-w-xs{{ dimIfNoPrice }}" data-price-calc-target="dim">
                <label class="field-label" for="{{ form.promoPrice.vars.id }}">Cena promocyjna <span class="font-normal text-zinc-400">(opcjonalnie)</span></label>
                <div class="relative">
                    {{ form_widget(form.promoPrice, { attr: { class: 'field-input pr-10', step: '0.01', placeholder: '0,00', 'data-price-calc-target': 'promo', 'data-action': 'input->price-calc#update' } }) }}
                    <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-zinc-400">zł</span>
                </div>
                <p class="mt-1 text-xs text-zinc-400">Zostaw puste, jeśli nie chcesz promocji.</p>
            </div>

            {# Free eBook + Pay what you want #}
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <label class="flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-zinc-200 p-4">
                    <div>
                        <p class="font-semibold text-zinc-900">Udostępnij eBook za darmo</p>
                        <p class="text-xs text-zinc-500">Czytelnicy pobiorą go bezpłatnie — cena zostanie ukryta.</p>
                    </div>
                    <span class="relative inline-flex shrink-0 items-center">
                        {{ form_widget(form.isFree, { attr: { class: 'peer sr-only', 'data-price-calc-target': 'free', 'data-action': 'change->price-calc#update' } }) }}
                        <span class="h-6 w-11 rounded-full bg-zinc-300 transition-colors peer-checked:bg-accent-600"></span>
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
                    </span>
                </label>
                <label class="flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-zinc-200 p-4">
                    <div>
                        <p class="font-semibold text-zinc-900">Zapłać ile chcesz</p>
                        <p class="text-xs text-zinc-500">Pozwól czytelnikom przekazać dobrowolną wpłatę za eBooka.</p>
                    </div>
                    <span class="relative inline-flex shrink-0 items-center">
                        {{ form_widget(form.payWhatYouWant, { attr: { class: 'peer sr-only', 'data-price-calc-target': 'pwyw', 'data-action': 'change->price-calc#update' } }) }}
                        <span class="h-6 w-11 rounded-full bg-zinc-300 transition-colors peer-checked:bg-accent-600"></span>
                        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
                    </span>
                </label>
            </div>

        </div>

        {# Side panel #}
        <div class="space-y-6">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-zinc-100">
                <h3 class="text-base font-semibold text-zinc-900">Podgląd Twojego eBooka</h3>
                <div class="mt-4 flex gap-4">
                    <twig:Ebook:Cover :src="data.coverDataUri" title="{{ data.title ?: 'Tytuł eBooka' }}" width="w-28" />
                    <div class="min-w-0">
                        <p class="break-words font-semibold text-zinc-900">{{ data.title ?: 'Tytuł eBooka' }}</p>
                        <p class="break-words text-sm text-zinc-500">{{ data.author ?: 'Autor' }}</p>
                        <p class="mt-3 text-xs text-zinc-400">Cena eBooka</p>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-lg font-bold {{ effectiveColor }}" data-price-calc-target="effective">{{ effectiveText }}</span>
                            <span class="text-sm text-zinc-400 line-through {{ discounted ? '' : 'hidden' }}" data-price-calc-target="original">{{ price|number_format(2, ',', ' ') }} zł</span>
                            <span class="rounded-full bg-error-50 px-2 py-0.5 text-xs font-bold text-error-600 {{ discounted ? '' : 'hidden' }}" data-price-calc-target="discount">-{{ discountPct }}%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-zinc-100">
                <twig:Icon name="shield" class="mt-0.5 h-6 w-6 shrink-0 text-accent-600" />
                <div>
                    <p class="text-sm font-semibold text-zinc-900">Bezpieczne i przejrzyste wypłaty</p>
                    <p class="mt-1 text-sm text-zinc-500">Wypłacamy Twoje zarobki regularnie na wskazane konto bankowe.</p>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block flow_actions %}
    <twig:Button href="{{ path('app_publish_ebook', { step: 2 }) }}" variant="outline">
        <twig:Icon name="arrow-left" class="h-5 w-5" /> Wstecz
    </twig:Button>
    <a href="{{ path('app_publish_ebook', { step: 3 }) }}?draft=1" class="inline-flex items-center justify-center rounded-ui border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">Zapisz szkic</a>
    <twig:Button type="submit" variant="primary" size="lg" form="wizard-form">
        Dalej <twig:Icon name="arrow-right" class="h-5 w-5" />
    </twig:Button>
{% endblock %}
