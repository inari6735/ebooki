{% extends 'ebook/publish/layout.html.twig' %}

{% block flow_body %}
    {% set price = data.price ?: 29.99 %}
    {% set promo = data.promoPrice %}
    {% set noPrice = data.isFree or data.payWhatYouWant %}
    {% set discounted = not noPrice and promo and promo > 0 and promo < price %}
    {% set discountPct = discounted ? ((price - promo) / price * 100)|round : 0 %}
    {% set dimIfNoPrice = noPrice ? ' pointer-events-none opacity-50' : '' %}
    {% set effectiveText = data.isFree ? 'Za darmo' : (data.payWhatYouWant ? 'Dobrowolna wpłata' : (discounted ? promo : price)|number_format(2, ',', ' ') ~ ' zł') %}
    {% set effectiveColor = data.isFree ? 'text-success-600' : (data.payWhatYouWant ? 'text-accent-600' : 'text-zinc-900') %}
    {{ form_start(form, { attr: { id: 'wizard-form', novalidate: 'novalidate' } }) }}
    <div class="grid gap-6 lg:grid-cols-3" data-controller="price-calc">
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Ustaw cenę i sposób sprzedaży</h2>
            <p class="mt-1 text-sm text-zinc-500">Sam decydujesz, ile zarobisz. To proste i przejrzyste.</p>

            {% include 'ebook/publish/_pricing_fields.html.twig' %}
        </div>

        {# Side panel #}
        <div class="space-y-6">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-zinc-100">
                <h3 class="text-base font-semibold text-zinc-900">Podgląd Twojego eBooka</h3>
                <div class="mt-4 flex gap-4">
                    <twig:Ebook:Cover :src="data.coverMediaId ? path('app_ebook_staged_preview', { mediaId: data.coverMediaId }) : null" title="{{ data.title ?: 'Tytuł eBooka' }}" width="w-28" />
                    <div class="min-w-0">
                        <p class="break-words font-semibold text-zinc-900">{{ data.title ?: 'Tytuł eBooka' }}</p>
                        <p class="break-words text-sm text-zinc-500">{{ data.author ?: 'Autor' }}</p>
                        <p class="mt-3 text-xs text-zinc-400">Cena eBooka</p>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-lg font-bold {{ effectiveColor }}" data-price-calc-target="effective">{{ effectiveText }}</span>
                            <span class="text-sm text-zinc-400 line-through {{ discounted ? '' : 'hidden' }}" data-price-calc-target="original">{{ price|number_format(2, ',', ' ') }} zł</span>
                            <span class="rounded-full bg-error-50 px-2 py-0.5 text-xs font-bold text-error-600 {{ discounted ? '' : 'hidden' }}" data-price-calc-target="discount">-{{ discountPct }}%</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-zinc-100">
                <twig:Icon name="shield" class="mt-0.5 h-6 w-6 shrink-0 text-accent-600" />
                <div>
                    <p class="text-sm font-semibold text-zinc-900">Bezpieczne i przejrzyste wypłaty</p>
                    <p class="mt-1 text-sm text-zinc-500">Wypłacamy Twoje zarobki regularnie na wskazane konto bankowe.</p>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block flow_actions %}
    <twig:Button href="{{ path('app_publish_ebook', { step: 2 }) }}" variant="outline">
        <twig:Icon name="arrow-left" class="h-5 w-5" /> Wstecz
    </twig:Button>
    <twig:Button type="submit" variant="primary" size="lg" form="wizard-form">
        Dalej <twig:Icon name="arrow-right" class="h-5 w-5" />
    </twig:Button>
{% endblock %}
