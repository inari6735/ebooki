{% extends 'ebook/publish/layout.html.twig' %}

{% set tips = [
    { icon: 'check',        title: 'Automatyczna walidacja', text: 'Sprawdzimy plik pod kątem błędów i zgodności z wymaganiami platformy.' },
    { icon: 'edit',         title: 'Prosta konfiguracja',    text: 'Dodaj tytuł, opis i ustaw cenę w kilku prostych krokach.' },
    { icon: 'cloud-upload', title: 'Szybka publikacja',      text: 'Twój eBook może być dostępny dla tysięcy czytelników jeszcze dziś.' },
    { icon: 'settings',     title: 'Bez ukrytych opłat',     text: 'Płacisz tylko za sprzedaż. Bez żadnych opłat wstępnych.' },
] %}

{% block flow_body %}
    {{ form_start(form, { attr: { id: 'wizard-form' } }) }}
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Plik eBooka</h2>
            <p class="mt-1 text-sm text-zinc-500">Prześlij plik w formatach: {{ rules.fileFormats }}.</p>

            {# eBook file dropzone #}
            <div class="mt-5 rounded-2xl border-2 border-dashed border-zinc-200 p-6 transition-colors"
                 data-controller="file-input"
                 data-action="click->file-input#open dragover->file-input#dragover dragleave->file-input#dragleave drop->file-input#drop">
                {{ form_widget(form.file, { attr: {
                    class: 'hidden',
                    accept: rules.fileAccept,
                    'data-file-input-target': 'input',
                    'data-action': 'file-input#change',
                } }) }}
                <div class="cursor-pointer text-center" data-file-input-target="idle">
                    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                        <twig:Icon name="cloud-upload" class="h-7 w-7" />
                    </span>
                    <p class="mt-3 font-semibold text-zinc-900">Przeciągnij i upuść plik tutaj</p>
                    <p class="text-sm text-zinc-500">lub kliknij, aby wybrać z dysku</p>
                    <p class="mt-2 text-xs text-zinc-400">Obsługiwane formaty: {{ rules.fileFormats }} · Maks. rozmiar: {{ rules.fileMaxMb }} MB</p>
                </div>
                <div class="hidden items-center gap-4 rounded-xl border border-zinc-100 bg-white p-4" data-file-input-target="filled">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-error-50 text-error-600">
                        <twig:Icon name="book" class="h-5 w-5" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-medium text-zinc-900" data-file-input-target="name">{{ data.fileName }}</p>
                        <p class="text-xs text-zinc-400" data-file-input-target="size">{{ data.fileSize }}</p>
                    </div>
                    <twig:Icon name="check" class="h-5 w-5 text-success-600" />
                    <button type="button" data-action="file-input#clear" class="text-zinc-400 hover:text-zinc-600" aria-label="Usuń plik">
                        <twig:Icon name="x" class="h-5 w-5" />
                    </button>
                </div>
            </div>
            {{ form_errors(form.file) }}

            {# Cover #}
            <h3 class="mt-8 text-base font-semibold text-zinc-900">Okładka eBooka <span class="font-normal text-zinc-400">(opcjonalnie)</span></h3>
            <p class="mt-1 text-sm text-zinc-500">Prześlij okładkę w formatach: {{ rules.coverFormats }}. Zalecane proporcje: 2:3 (pionowa okładka).</p>

            <div class="mt-4 grid gap-4 sm:grid-cols-2" data-controller="file-input"
                 data-action="dragover->file-input#dragover dragleave->file-input#dragleave drop->file-input#drop">
                {{ form_widget(form.cover, { attr: {
                    class: 'hidden',
                    accept: rules.coverAccept,
                    'data-file-input-target': 'input',
                    'data-action': 'file-input#change',
                } }) }}
                <div class="cursor-pointer rounded-2xl border-2 border-dashed border-zinc-200 p-5 text-center"
                     data-action="click->file-input#open">
                    <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                        <twig:Icon name="book" class="h-5 w-5" />
                    </span>
                    <p class="mt-2 text-sm font-medium text-zinc-800">Przeciągnij i upuść okładkę tutaj</p>
                    <p class="text-xs text-zinc-500">lub kliknij, aby wybrać plik</p>
                    <p class="mt-1 text-xs text-zinc-400">{{ rules.coverFormats }} · Maks. rozmiar: {{ rules.coverMaxMb }} MB</p>
                </div>
                <div class="flex items-center gap-3 rounded-2xl border border-zinc-100 p-4 {{ data.coverName ? '' : 'hidden' }}" data-file-input-target="filled">
                    <img data-file-input-target="preview" src="{{ data.coverDataUri }}" alt=""
                         class="aspect-cover w-11 shrink-0 rounded bg-zinc-100 object-cover ring-1 ring-zinc-900/5">
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium text-zinc-900" data-file-input-target="name">{{ data.coverName ?: 'okladka.png' }}</p>
                        <button type="button" data-action="file-input#clear" class="mt-1 text-xs font-medium text-zinc-500 hover:text-error-600">Usuń</button>
                    </div>
                    <twig:Icon name="check" class="h-5 w-5 text-success-600" />
                </div>
            </div>
            {{ form_errors(form.cover) }}
        </div>

        {# Side panel #}
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100">
            <div class="flex items-center gap-2 text-accent-600">
                <twig:Icon name="clock" class="h-5 w-5" />
                <h3 class="text-base font-semibold text-zinc-900">Całość zajmie tylko kilka minut</h3>
            </div>
            <ul class="mt-6 space-y-5">
                {% for t in tips %}
                    <li class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                            <twig:Icon name="{{ t.icon }}" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-zinc-800">{{ t.title }}</p>
                            <p class="mt-0.5 text-sm text-zinc-500">{{ t.text }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            <div class="mt-6 flex items-start gap-3 rounded-xl bg-accent-50 p-4">
                <twig:Icon name="lock" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
                <p class="text-sm text-zinc-600">Twoje pliki są <span class="font-semibold text-zinc-800">bezpieczne i prywatne</span>. Nikt poza Tobą nie ma do nich dostępu.</p>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block flow_actions %}
    <a href="{{ path('app_publish_ebook', { step: 1 }) }}?draft=1" class="inline-flex items-center justify-center rounded-ui border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">Zapisz szkic</a>
    <twig:Button type="submit" variant="primary" size="lg" form="wizard-form">
        Dalej <twig:Icon name="arrow-right" class="h-5 w-5" />
    </twig:Button>
{% endblock %}
