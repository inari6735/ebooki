{% extends 'ebook/publish/layout.html.twig' %}

{% set tips = [
    { icon: 'check',        title: 'Automatyczna walidacja', text: 'Sprawdzimy plik pod kątem błędów i zgodności z wymaganiami platformy.' },
    { icon: 'edit',         title: 'Prosta konfiguracja',    text: 'Dodaj tytuł, opis i ustaw cenę w kilku prostych krokach.' },
    { icon: 'cloud-upload', title: 'Wysyłka na końcu',       text: 'Pliki trafiają do biblioteki dopiero, gdy zatwierdzisz formularz w ostatnim kroku.' },
    { icon: 'settings',     title: 'Bez ukrytych opłat',     text: 'Płacisz tylko za sprzedaż. Bez żadnych opłat wstępnych.' },
] %}

{% block flow_body %}
    <form id="wizard-form" method="post" action="{{ path('app_publish_ebook', { step: 1 }) }}"></form>
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Plik eBooka</h2>
            <p class="mt-1 text-sm text-zinc-500">Prześlij plik (lub kilka formatów) w formatach: {{ rules.fileFormats }}.</p>

            {% include 'ebook/publish/_uploads.html.twig' %}
        </div>

        {# Side panel #}
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100">
            <div class="flex items-center gap-2 text-accent-600">
                <twig:Icon name="clock" class="h-5 w-5" />
                <h3 class="text-base font-semibold text-zinc-900">Całość zajmie tylko kilka minut</h3>
            </div>
            <ul class="mt-6 space-y-5">
                {% for t in tips %}
                    <li class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                            <twig:Icon name="{{ t.icon }}" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-zinc-800">{{ t.title }}</p>
                            <p class="mt-0.5 text-sm text-zinc-500">{{ t.text }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            <div class="mt-6 flex items-start gap-3 rounded-xl bg-accent-50 p-4">
                <twig:Icon name="lock" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
                <p class="text-sm text-zinc-600">Twoje pliki są <span class="font-semibold text-zinc-800">bezpieczne i prywatne</span>. Nikt poza Tobą nie ma do nich dostępu.</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block flow_actions %}
    <twig:Button type="submit" variant="primary" size="lg" form="wizard-form">
        Dalej <twig:Icon name="arrow-right" class="h-5 w-5" />
    </twig:Button>
{% endblock %}
