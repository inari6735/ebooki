{# Shared eBook detail fields — used by the publish wizard (step 2) AND the edit form,
   so the inputs, limits (maxlength) and validation rendering never diverge.
   Requires: `form` (with title/author/category/language/shortDescription/description)
   and `data` (a PublishEbookData, for prefilling the detail rows). #}

{% if form.vars.submitted and not form.vars.valid %}
    <twig:Alert type="error" class="mt-4">Uzupełnij wymagane pola oznaczone *.</twig:Alert>
{% endif %}

<div class="mt-6 grid gap-5 sm:grid-cols-2">
    <div data-controller="char-counter" data-char-counter-max-value="200">
        <label class="field-label" for="{{ form.title.vars.id }}">Tytuł eBooka *</label>
        {{ form_widget(form.title, { attr: { class: 'field-input', required: true, maxlength: 200, 'data-char-counter-target': 'field', 'data-preview-field': 'title', 'data-action': 'input->char-counter#update input->preview#update' } }) }}
        {{ form_errors(form.title) }}
        <p class="mt-1 text-right text-xs text-zinc-400" data-char-counter-target="count"></p>
    </div>
    <div data-controller="char-counter" data-char-counter-max-value="80">
        <label class="field-label" for="{{ form.author.vars.id }}">Autor *</label>
        {{ form_widget(form.author, { attr: { class: 'field-input', required: true, maxlength: 80, 'data-char-counter-target': 'field', 'data-preview-field': 'author', 'data-action': 'input->char-counter#update input->preview#update' } }) }}
        {{ form_errors(form.author) }}
        <p class="mt-1 text-right text-xs text-zinc-400" data-char-counter-target="count"></p>
    </div>
    <div>
        <label class="field-label" for="{{ form.category.vars.id }}">Kategoria główna *</label>
        {{ form_widget(form.category, { attr: { class: 'field-input', required: true, 'data-preview-field': 'category', 'data-action': 'change->preview#update' } }) }}
        {{ form_errors(form.category) }}
    </div>
    <div>
        <label class="field-label" for="{{ form.language.vars.id }}">Język *</label>
        {{ form_widget(form.language, { attr: { class: 'field-input', 'data-preview-field': 'language', 'data-action': 'change->preview#update' } }) }}
        {{ form_errors(form.language) }}
    </div>
</div>

<div class="mt-5" data-controller="char-counter" data-char-counter-max-value="400">
    <label class="field-label" for="{{ form.shortDescription.vars.id }}">Krótki opis *</label>
    {{ form_widget(form.shortDescription, { attr: { class: 'field-input', required: true, maxlength: 400, 'data-char-counter-target': 'field', 'data-preview-field': 'shortDescription', 'data-action': 'input->char-counter#update input->preview#update' } }) }}
    {{ form_errors(form.shortDescription) }}
    <p class="mt-1 text-right text-xs text-zinc-400" data-char-counter-target="count"></p>
</div>

<div class="mt-5" data-controller="char-counter" data-char-counter-max-value="10000">
    <label class="field-label" for="{{ form.description.vars.id }}">Opis eBooka *</label>
    {{ form_widget(form.description, { attr: { class: 'field-input', required: true, rows: 5, maxlength: 10000, 'data-char-counter-target': 'field', 'data-action': 'input->char-counter#update' } }) }}
    {{ form_errors(form.description) }}
    <p class="mt-1 text-right text-xs text-zinc-400" data-char-counter-target="count"></p>
</div>

{# Detailed info (key : value) — rendered as a table on the eBook detail page #}
{% set details = data.details ?: [{ key: 'Liczba stron', value: '' }, { key: 'Rok wydania', value: '' }] %}
{% set keyMax = constant('App\\Ebook\\Presentation\\PublishEbook\\PublishEbookData::DETAIL_KEY_MAX') %}
{% set valueMax = constant('App\\Ebook\\Presentation\\PublishEbook\\PublishEbookData::DETAIL_VALUE_MAX') %}
<div class="mt-6" data-controller="key-value">
    <p class="text-sm font-semibold text-zinc-800">Szczegółowe informacje</p>
    <p class="mb-2 text-xs text-zinc-500">Dodaj pola w formie „nazwa : wartość" (np. Wydawca : Bookly). Pojawią się jako tabela na stronie eBooka. Nazwa do {{ keyMax }} znaków, wartość do {{ valueMax }} znaków.</p>

    <div class="space-y-2" data-key-value-target="list">
        {% for d in details %}
            <div class="flex items-center gap-2" data-key-value-target="row">
                <input type="text" name="detailKeys[]" value="{{ d.key }}" maxlength="{{ keyMax }}" placeholder="Nazwa, np. Wydawca" class="field-input flex-1">
                <input type="text" name="detailValues[]" value="{{ d.value }}" maxlength="{{ valueMax }}" placeholder="Wartość, np. Bookly" class="field-input flex-[2]">
                <button type="button" data-action="key-value#remove" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-ui text-zinc-400 hover:bg-zinc-100 hover:text-error-600" aria-label="Usuń wiersz">
                    <twig:Icon name="x" class="h-5 w-5" />
                </button>
            </div>
        {% endfor %}
    </div>

    <template data-key-value-target="template">
        <div class="flex items-center gap-2" data-key-value-target="row">
            <input type="text" name="detailKeys[]" maxlength="{{ keyMax }}" placeholder="Nazwa, np. Wydawca" class="field-input flex-1">
            <input type="text" name="detailValues[]" maxlength="{{ valueMax }}" placeholder="Wartość, np. Bookly" class="field-input flex-[2]">
            <button type="button" data-action="key-value#remove" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-ui text-zinc-400 hover:bg-zinc-100 hover:text-error-600" aria-label="Usuń wiersz">
                <twig:Icon name="x" class="h-5 w-5" />
            </button>
        </div>
    </template>

    <button type="button" data-action="key-value#add" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 hover:text-accent-700">
        <twig:Icon name="plus" class="h-4 w-4" /> Dodaj pole
    </button>
</div>
