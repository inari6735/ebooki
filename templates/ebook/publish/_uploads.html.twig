{# Shared eBook file + cover uploader — used by the publish wizard (step 1) AND the
   edit form, so uploads behave/validate identically. `ctx` selects the staging
   workspace: empty = wizard, an eBook id = that eBook's edit session.
   Requires: `data` (files + coverMediaId/coverName), `rules`. #}
{% set uploadToken = csrf_token('ebook_upload') %}
{% set removeUrl = path('app_ebook_stage_remove', { mediaId: '__ID__' }) %}
{% set ctx = ctx|default('') %}

{# eBook files — multiple, staged on add #}
<div class="mt-5 rounded-2xl border-2 border-dashed border-zinc-200 p-6 transition-colors"
     data-controller="staged-upload"
     data-staged-upload-init-url-value="{{ path('app_ebook_chunk_init') }}"
     data-staged-upload-chunk-url-value="{{ path('app_ebook_chunk') }}"
     data-staged-upload-finalize-url-value="{{ path('app_ebook_chunk_finalize') }}"
     data-staged-upload-remove-url-value="{{ removeUrl }}"
     data-staged-upload-token-value="{{ uploadToken }}"
     data-staged-upload-context-value="{{ ctx }}"
     data-staged-upload-form-id-value="{{ formId|default('wizard-form') }}"
     data-staged-upload-max-size-mb-value="{{ rules.fileMaxMb }}"
     data-staged-upload-max-count-value="{{ rules.fileMaxCount }}"
     data-staged-upload-accept-value="{{ rules.fileExtensions }}"
     data-action="dragover->staged-upload#dragover dragleave->staged-upload#dragleave drop->staged-upload#drop">
    <input type="file" multiple class="hidden" accept="{{ rules.fileAccept }}"
           data-staged-upload-target="input" data-action="staged-upload#change">
    <div class="cursor-pointer text-center" data-action="click->staged-upload#open">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-accent-50 text-accent-600">
            <twig:Icon name="cloud-upload" class="h-7 w-7" />
        </span>
        <p class="mt-3 font-semibold text-zinc-900">Przeciągnij i upuść pliki tutaj</p>
        <p class="text-sm text-zinc-500">lub kliknij, aby wybrać z dysku</p>
        <p class="mt-2 text-xs text-zinc-400">Obsługiwane formaty: {{ rules.fileFormats }} · Maks. rozmiar: {{ rules.fileMaxMb }} MB · Do {{ rules.fileMaxCount }} plików, każdy format raz</p>
    </div>
    <p class="mt-3 text-sm text-error-600 empty:hidden" data-staged-upload-target="error"></p>
    <div class="mt-4 space-y-2 {{ data.files is empty ? 'hidden' }}" data-staged-upload-target="list">
        {% for f in data.files %}
            <div class="flex items-center gap-3 rounded-xl border border-zinc-100 bg-white p-3 shadow-sm" data-media-id="{{ f.mediaId }}" data-format="{{ f.format }}">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                    <twig:Icon name="book" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium text-zinc-900">{{ f.name }}</p>
                    <p class="mt-1 text-xs text-zinc-400">{{ f.size }} · {{ f.format|upper }}</p>
                </div>
                <button type="button" data-action="staged-upload#remove" class="shrink-0 text-zinc-400 hover:text-error-600" aria-label="Usuń">
                    <twig:Icon name="x" class="h-5 w-5" />
                </button>
            </div>
        {% endfor %}
    </div>
</div>

{# Cover — single, staged on add #}
<h3 class="mt-8 text-base font-semibold text-zinc-900">Okładka eBooka <span class="font-normal text-zinc-400">(opcjonalnie)</span></h3>
<p class="mt-1 text-sm text-zinc-500">Prześlij okładkę w formatach: {{ rules.coverFormats }}. Zalecane proporcje: 2:3 (pionowa okładka).</p>

<div class="mt-4 rounded-2xl border-2 border-dashed border-zinc-200 p-5 transition-colors"
     data-controller="staged-upload"
     data-staged-upload-upload-url-value="{{ path('app_ebook_stage_cover') }}"
     data-staged-upload-remove-url-value="{{ removeUrl }}"
     data-staged-upload-token-value="{{ uploadToken }}"
     data-staged-upload-context-value="{{ ctx }}"
     data-staged-upload-form-id-value="{{ formId|default('wizard-form') }}"
     data-staged-upload-cover-value="true"
     data-staged-upload-max-size-mb-value="{{ rules.coverMaxMb }}"
     data-staged-upload-accept-value="{{ rules.coverExtensions }}"
     data-action="dragover->staged-upload#dragover dragleave->staged-upload#dragleave drop->staged-upload#drop">
    <input type="file" class="hidden" accept="{{ rules.coverAccept }}"
           data-staged-upload-target="input" data-action="staged-upload#change">
    <div class="cursor-pointer text-center" data-action="click->staged-upload#open">
        <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
            <twig:Icon name="book" class="h-5 w-5" />
        </span>
        <p class="mt-2 text-sm font-medium text-zinc-800">Przeciągnij i upuść okładkę tutaj</p>
        <p class="text-xs text-zinc-500">lub kliknij, aby wybrać plik</p>
        <p class="mt-1 text-xs text-zinc-400">{{ rules.coverFormats }} · Maks. rozmiar: {{ rules.coverMaxMb }} MB</p>
    </div>
    <p class="mt-3 text-sm text-error-600 empty:hidden" data-staged-upload-target="error"></p>
    <div class="mt-4 {{ data.coverMediaId is null ? 'hidden' }}" data-staged-upload-target="list">
        {% if data.coverMediaId %}
            <div class="flex items-center gap-4 rounded-2xl border border-zinc-100 bg-white p-4 shadow-sm" data-media-id="{{ data.coverMediaId }}">
                <span class="block w-16 shrink-0 overflow-hidden rounded-lg bg-accent-50 shadow ring-1 ring-zinc-100/60" style="aspect-ratio: 2 / 3;">
                    <img src="{{ path('app_ebook_staged_preview', ctx ? { mediaId: data.coverMediaId, ctx: ctx } : { mediaId: data.coverMediaId }) }}" alt="Podgląd okładki" class="h-full w-full object-cover">
                </span>
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Podgląd okładki</p>
                    <p class="mt-0.5 truncate text-sm font-medium text-zinc-900">{{ data.coverName }}</p>
                </div>
                <button type="button" data-action="staged-upload#remove" class="shrink-0 text-zinc-400 hover:text-error-600" aria-label="Usuń">
                    <twig:Icon name="x" class="h-5 w-5" />
                </button>
            </div>
        {% endif %}
    </div>
</div>
