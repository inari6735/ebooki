{% extends 'ebook/publish/layout.html.twig' %}

{# Anonymous authors: mount the in-page auth modal on the shell root so the
   finalize buttons (in the action bar) and the modal share an ancestor. #}
{% block shell_root_attr %}{% if app.user is null %} data-controller="auth-modal" data-auth-modal-login-url-value="{{ path('app_login') }}" data-auth-modal-register-url-value="{{ path('app_register') }}"{% endif %}{% endblock %}

{% set basePrice = data.price ?: 29.99 %}
{% set promoPrice = data.promoPrice %}
{% set noPrice = data.isFree or data.payWhatYouWant %}
{% set discounted = not noPrice and promoPrice and promoPrice > 0 and promoPrice < basePrice %}
{% set effectivePrice = discounted ? promoPrice : basePrice %}
{% set discountPct = discounted ? ((basePrice - promoPrice) / basePrice * 100)|round : 0 %}
{% set priceText = data.isFree ? 'eBook dostępny za darmo' : (data.payWhatYouWant ? 'Zapłać ile chcesz — dobrowolna wpłata' : 'Cena eBooka: ' ~ effectivePrice|number_format(2, ',', ' ') ~ ' zł') %}
{% set checklist = [
    { title: 'Plik dodany',      text: data.files is not empty ? (data.files|length ~ ' plik(i): ' ~ (data.files|map(f => f.format|upper)|join(', '))) : 'Brak pliku' },
    { title: 'Okładka gotowa',   text: data.coverName ?: 'Brak okładki' },
    { title: 'Opis uzupełniony', text: 'Tytuł, autor i opis eBooka zostały dodane.' },
    { title: 'Cena ustawiona',   text: priceText },
] %}
{% set settings = [
    { icon: 'tag',      title: 'Kategoria',       text: (data.category ?: 'Rozwój osobisty') ~ ' — główna kategoria' },
    { icon: 'calendar', title: 'Data publikacji', text: 'Natychmiast — opublikuj od razu' },
    { icon: 'shield',   title: 'Prawa autorskie', text: 'Chronione — Twoje prawa są bezpieczne' },
] %}
{% set tips = [
    { icon: 'cloud-upload', title: 'Opublikuj natychmiast',      text: 'Twój eBook pojawi się w sklepie od razu po kliknięciu publikuj.' },
    { icon: 'edit',         title: 'Edytuj w dowolnym momencie', text: 'Możesz w każdej chwili zaktualizować opis, cenę lub plik.' },
    { icon: 'chart',        title: 'Bezpieczne wypłaty',         text: 'Regularne wypłaty wprost na Twoje konto.' },
    { icon: 'lightning',    title: 'Dotrzyj do czytelników szybko', text: 'Skuteczne narzędzia promocyjne pomogą Ci zbudować zasięg.' },
] %}

{% block flow_body %}
    <form id="publish-form" method="post" action="{{ path('app_publish_ebook', { step: 4 }) }}"></form>
    <form id="draft-form" method="post" action="{{ path('app_publish_ebook', { step: 4 }) }}?draft=1"></form>
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Podsumowanie publikacji</h2>
            <p class="mt-1 text-sm text-zinc-500">Sprawdź wszystkie elementy przed opublikowaniem eBooka.</p>

            <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <ul class="space-y-5">
                    {% for c in checklist %}
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-success-50 text-success-600">
                                <twig:Icon name="check" class="h-4 w-4" />
                            </span>
                            <div>
                                <p class="text-sm font-semibold text-zinc-900">{{ c.title }}</p>
                                <p class="text-sm text-zinc-500">{{ c.text }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <div>
                    <p class="text-sm font-semibold text-zinc-800">Podgląd eBooka w sklepie</p>
                    <div class="mt-3 flex gap-4 rounded-2xl border border-zinc-100 p-4">
                        <twig:Ebook:Cover :src="data.coverMediaId ? path('app_ebook_staged_preview', { mediaId: data.coverMediaId }) : null" title="{{ data.title ?: 'Światło na końcu drogi' }}" width="w-28" />
                        <div class="min-w-0">
                            <p class="break-words font-semibold text-zinc-900">{{ data.title ?: 'Światło na końcu drogi' }}</p>
                            <p class="break-words text-sm text-zinc-500">{{ data.author ?: 'Anna Kowalska' }}</p>
                            <div class="mt-2 flex gap-1.5">
                                <twig:Badge variant="brand">eBook</twig:Badge>
                                <twig:Badge variant="neutral">PDF</twig:Badge>
                            </div>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                {% if data.isFree %}
                                    <span class="text-lg font-bold text-success-600">Za darmo</span>
                                {% elseif data.payWhatYouWant %}
                                    <span class="text-lg font-bold text-accent-600">Dobrowolna wpłata</span>
                                {% else %}
                                    <span class="text-lg font-bold text-zinc-900">{{ effectivePrice|number_format(2, ',', ' ') }} zł</span>
                                    {% if discounted %}
                                        <span class="text-sm text-zinc-400 line-through">{{ basePrice|number_format(2, ',', ' ') }} zł</span>
                                        <span class="rounded-full bg-error-50 px-2 py-0.5 text-xs font-bold text-error-600">-{{ discountPct }}%</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                            <p class="mt-1 break-words text-xs text-zinc-500">{{ data.shortDescription }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <p class="mt-8 text-sm font-semibold text-zinc-800">Ustawienia publikacji</p>
            <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {% for s in settings %}
                    <div class="rounded-xl border border-zinc-100 p-4">
                        <twig:Icon name="{{ s.icon }}" class="h-5 w-5 text-accent-600" />
                        <p class="mt-2 text-sm font-semibold text-zinc-900">{{ s.title }}</p>
                        <p class="text-xs text-zinc-500">{{ s.text }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Side panel — ready to publish #}
        <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-zinc-100">
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-50 text-3xl">🎉</span>
            <h3 class="mt-4 text-xl font-bold text-zinc-900">Gotowe do publikacji!</h3>
            <p class="mt-1 text-sm text-zinc-500">Twój eBook jest gotowy, aby trafić do tysięcy czytelników.</p>

            <ul class="mt-6 space-y-4 text-left">
                {% for t in tips %}
                    <li class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                            <twig:Icon name="{{ t.icon }}" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-zinc-800">{{ t.title }}</p>
                            <p class="mt-0.5 text-sm text-zinc-500">{{ t.text }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <twig:Button href="{{ path('app_publish_ebook_preview') }}" target="_blank" rel="noopener"
                         variant="outline" size="lg" wide class="mt-8">
                <twig:Icon name="eye" class="h-5 w-5" /> Podgląd strony eBooka
            </twig:Button>
            <twig:Button type="submit" variant="primary" size="lg" wide form="publish-form" class="mt-3"
                         data-action="click->auth-modal#open" data-auth-modal-intent-param="publish">
                <twig:Icon name="cloud-upload" class="h-5 w-5" /> Opublikuj eBook
            </twig:Button>
            <p class="mt-3 text-xs text-zinc-400">Publikując, akceptujesz regulamin Bookly.</p>
        </div>
    </div>
    {% if app.user is null %}
        {# In-page auth modal — no navigation away, the wizard stays filled in. #}
        <div data-auth-modal-target="modal" data-action="click->auth-modal#backdrop"
             class="fixed inset-0 z-50 hidden items-center justify-center bg-zinc-900/60 p-4">
            <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl sm:p-7">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-zinc-900">Jeszcze jeden krok</h3>
                        <p class="mt-1 text-sm text-zinc-500">Zaloguj się lub załóż konto, aby dokończyć. Twój formularz pozostaje wypełniony.</p>
                    </div>
                    <button type="button" data-action="auth-modal#close" class="shrink-0 text-zinc-400 hover:text-zinc-600" aria-label="Zamknij">
                        <twig:Icon name="x" class="h-5 w-5" />
                    </button>
                </div>

                <div class="mt-5 grid grid-cols-2 gap-1 rounded-xl bg-zinc-100 p-1 text-sm font-semibold">
                    <button type="button" data-auth-modal-target="loginTab" data-action="auth-modal#showLogin" class="rounded-lg bg-white px-3 py-2 text-accent-700 shadow-sm">Zaloguj się</button>
                    <button type="button" data-auth-modal-target="registerTab" data-action="auth-modal#showRegister" class="rounded-lg px-3 py-2 text-zinc-500">Załóż konto</button>
                </div>

                {# Same shared forms as the login/register pages — options never diverge. #}
                <div data-auth-modal-target="loginPanel" class="mt-6">
                    <p class="mb-3 text-sm text-error-600 empty:hidden" data-auth-modal-target="loginError"></p>
                    <twig:Auth:LoginForm :loginPath="path('app_login')" :formAttributes="{ 'data-action': 'submit->auth-modal#submitLogin' }" />
                </div>
                <div data-auth-modal-target="registerPanel" class="mt-6 hidden">
                    <p class="mb-3 text-sm text-error-600 empty:hidden" data-auth-modal-target="registerError"></p>
                    <twig:Auth:RegisterForm :registerPath="path('app_register')" :formAttributes="{ 'data-action': 'submit->auth-modal#submitRegister' }" />
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block flow_actions %}
    <twig:Button href="{{ path('app_publish_ebook', { step: 3 }) }}" variant="outline">
        <twig:Icon name="arrow-left" class="h-5 w-5" /> Wstecz
    </twig:Button>
    <button type="submit" form="draft-form" data-action="click->auth-modal#open" data-auth-modal-intent-param="draft" class="inline-flex items-center justify-center rounded-ui border border-zinc-200 bg-white px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">Zapisz szkic</button>
    <twig:Button href="{{ path('app_publish_ebook_preview') }}" target="_blank" rel="noopener" variant="outline">
        <twig:Icon name="eye" class="h-5 w-5" /> Podgląd
    </twig:Button>
    <twig:Button type="submit" variant="primary" size="lg" form="publish-form"
                 data-action="click->auth-modal#open" data-auth-modal-intent-param="publish">
        <twig:Icon name="cloud-upload" class="h-5 w-5" /> Opublikuj eBook
    </twig:Button>
{% endblock %}
