{% extends 'ebook/publish/layout.html.twig' %}

{# Anonymous authors: mount the in-page auth modal on the shell root so the
   finalize buttons (in the action bar) and the modal share an ancestor. #}
{% block shell_root_attr %}{% if app.user is null %} data-controller="auth-modal" data-auth-modal-login-url-value="{{ path('app_login') }}" data-auth-modal-register-url-value="{{ path('app_register') }}"{% endif %}{% endblock %}

{% set basePrice = data.price ?: 29.99 %}
{% set promoPrice = data.promoPrice %}
{% set noPrice = data.isFree or data.payWhatYouWant %}
{% set discounted = not noPrice and promoPrice and promoPrice > 0 and promoPrice < basePrice %}
{% set effectivePrice = discounted ? promoPrice : basePrice %}
{% set discountPct = discounted ? ((basePrice - promoPrice) / basePrice * 100)|round : 0 %}
{% set priceModel = data.isFree ? 'Za darmo' : (data.payWhatYouWant ? 'Zapłać ile chcesz' : 'Płatny') %}
{% set formats = data.files|map(f => f.format|upper)|join(', ') %}

{# One label→value row of the configuration spec sheet. #}
{% macro specRow(label, value, muted = false) %}
    <div class="flex items-center justify-between gap-4 px-4 py-2.5">
        <dt class="shrink-0 text-sm text-zinc-500">{{ label }}</dt>
        <dd class="truncate pl-4 text-right text-sm font-semibold {{ muted ? 'text-zinc-400' : 'text-zinc-900' }}">{{ value }}</dd>
    </div>
{% endmacro %}

{% set tips = [
    { icon: 'cloud-upload', title: 'Opublikuj natychmiast',      text: 'Twój eBook pojawi się w sklepie od razu po kliknięciu publikuj.' },
    { icon: 'edit',         title: 'Edytuj w dowolnym momencie', text: 'Możesz w każdej chwili zaktualizować opis, cenę lub plik.' },
    { icon: 'chart',        title: 'Bezpieczne wypłaty',         text: 'Regularne wypłaty wprost na Twoje konto.' },
    { icon: 'lightning',    title: 'Dotrzyj do czytelników szybko', text: 'Skuteczne narzędzia promocyjne pomogą Ci zbudować zasięg.' },
] %}

{% block flow_body %}
    <form id="publish-form" method="post" action="{{ path('app_publish_ebook', { step: 4 }) }}"></form>
    <form id="draft-form" method="post" action="{{ path('app_publish_ebook', { step: 4 }) }}?draft=1"></form>
    <div class="grid gap-6 lg:grid-cols-3">
        {% import _self as ui %}
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-zinc-100 lg:col-span-2">
            <h2 class="text-xl font-bold text-zinc-900">Podsumowanie publikacji</h2>
            <p class="mt-1 text-sm text-zinc-500">Sprawdź, co skonfigurowałeś — i zobacz, jak Twój eBook wygląda dla czytelnika.</p>

            {# Preview hero: the product's identity + price, with the detail-page
               preview action right where the summary lives. #}
            <div class="mt-6 overflow-hidden rounded-2xl border border-zinc-100">
                <div class="flex flex-col gap-5 bg-gradient-to-br from-accent-50/50 via-white to-white p-5 sm:flex-row">
                    <twig:Ebook:Cover :src="data.coverMediaId ? path('app_ebook_staged_preview', { mediaId: data.coverMediaId }) : null" title="{{ data.title ?: 'Tytuł eBooka' }}" width="w-24" />
                    <div class="min-w-0 flex-1">
                        <p class="break-words text-lg font-bold text-zinc-900">{{ data.title ?: 'Tytuł eBooka' }}</p>
                        <p class="break-words text-sm text-zinc-500">{{ data.author ?: 'Autor' }}</p>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            <twig:Badge variant="brand">eBook</twig:Badge>
                            {% for f in data.files %}<twig:Badge variant="neutral">{{ f.format|upper }}</twig:Badge>{% endfor %}
                        </div>
                        <div class="mt-2.5 flex flex-wrap items-center gap-2">
                            {% if data.isFree %}
                                <span class="text-xl font-bold text-success-600">Za darmo</span>
                            {% elseif data.payWhatYouWant %}
                                <span class="text-xl font-bold text-accent-600">Zapłać ile chcesz</span>
                            {% else %}
                                <span class="text-xl font-bold text-zinc-900">{{ effectivePrice|number_format(2, ',', ' ') }} zł</span>
                                {% if discounted %}
                                    <span class="text-sm text-zinc-400 line-through">{{ basePrice|number_format(2, ',', ' ') }} zł</span>
                                    <span class="rounded-full bg-error-50 px-2 py-0.5 text-xs font-bold text-error-600">-{{ discountPct }}%</span>
                                {% endif %}
                            {% endif %}
                        </div>
                        {% if data.shortDescription %}
                            <p class="mt-2 line-clamp-2 break-words text-xs text-zinc-500">{{ data.shortDescription }}</p>
                        {% endif %}
                    </div>
                </div>
                <div class="border-t border-zinc-100 bg-white p-3">
                    <twig:Button href="{{ path('app_publish_ebook_preview') }}" target="_blank" rel="noopener" variant="ghost" wide>
                        <twig:Icon name="eye" class="h-5 w-5" /> Zobacz podgląd strony eBooka
                    </twig:Button>
                </div>
            </div>

            {# Configured values, grouped and scannable — a real review sheet. #}
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <div>
                    <div class="flex items-center gap-2">
                        <twig:Icon name="book" class="h-4 w-4 text-accent-600" />
                        <h3 class="text-sm font-semibold text-zinc-900">O eBooku</h3>
                    </div>
                    <dl class="mt-3 divide-y divide-zinc-100 rounded-xl border border-zinc-100">
                        {{ ui.specRow('Kategoria', categoryName ?: 'Nie wybrano', categoryName is null) }}
                        {{ ui.specRow('Język', languageName ?: 'Nie wybrano', languageName is null) }}
                        {{ ui.specRow('Pliki', data.files|length ~ ' · ' ~ formats) }}
                        {{ ui.specRow('Okładka', data.coverName ? 'Dodana' : 'Brak', not data.coverName) }}
                        {{ ui.specRow('Opis', data.description|length ~ ' znaków') }}
                    </dl>
                </div>

                <div>
                    <div class="flex items-center gap-2">
                        <twig:Icon name="wallet" class="h-4 w-4 text-accent-600" />
                        <h3 class="text-sm font-semibold text-zinc-900">Cena i sprzedaż</h3>
                    </div>
                    <dl class="mt-3 divide-y divide-zinc-100 rounded-xl border border-zinc-100">
                        {{ ui.specRow('Model sprzedaży', priceModel) }}
                        {% if not noPrice %}
                            {{ ui.specRow('Cena', (effectivePrice|number_format(2, ',', ' ')) ~ ' zł') }}
                            {{ ui.specRow('Promocja', discounted ? (promoPrice|number_format(2, ',', ' ') ~ ' zł · -' ~ discountPct ~ '%') : 'Brak', not discounted) }}
                            {{ ui.specRow('Twój przychód', (effectivePrice * 0.9)|number_format(2, ',', ' ') ~ ' zł') }}
                        {% else %}
                            {{ ui.specRow('Twój przychód', data.isFree ? 'eBook bezpłatny' : 'Dobrowolne wpłaty', true) }}
                        {% endif %}
                    </dl>
                    {% if not noPrice %}
                        <p class="mt-2 px-1 text-xs text-zinc-400">Przychód po 10% prowizji platformy.</p>
                    {% endif %}
                </div>
            </div>

            {# Detailed info the author entered ("Szczegółowe informacje"). #}
            <div class="mt-6">
                <div class="flex items-center gap-2">
                    <twig:Icon name="sliders" class="h-4 w-4 text-accent-600" />
                    <h3 class="text-sm font-semibold text-zinc-900">Szczegółowe informacje</h3>
                </div>
                {% if data.details is not empty %}
                    <dl class="mt-3 divide-y divide-zinc-100 rounded-xl border border-zinc-100">
                        {% for d in data.details %}
                            {{ ui.specRow(d.key, d.value) }}
                        {% endfor %}
                    </dl>
                {% else %}
                    <p class="mt-3 rounded-xl border border-dashed border-zinc-200 px-4 py-3 text-sm text-zinc-400">Nie dodano — szczegółowe informacje są opcjonalne.</p>
                {% endif %}
            </div>
        </div>

        {# Side panel — ready to publish #}
        <div class="rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-zinc-100">
            <img src="{{ asset('images/add_ebook_success_icon.png') }}" alt="" class="mx-auto h-40 w-40 object-contain" width="160" height="160">
            <h3 class="text-xl font-bold text-zinc-900">Gotowe do publikacji!</h3>
            <p class="mt-1 text-sm text-zinc-500">Twój eBook jest gotowy, aby trafić do tysięcy czytelników.</p>

            <ul class="mt-6 space-y-4 text-left">
                {% for t in tips %}
                    <li class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
                            <twig:Icon name="{{ t.icon }}" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-zinc-800">{{ t.title }}</p>
                            <p class="mt-0.5 text-sm text-zinc-500">{{ t.text }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-8 space-y-3">
                <twig:Button type="submit" variant="primary" size="lg" wide form="publish-form"
                             data-action="click->auth-modal#open" data-auth-modal-intent-param="publish">
                    <twig:Icon name="cloud-upload" class="h-5 w-5" /> Opublikuj eBook
                </twig:Button>
                <twig:Button type="submit" variant="outline" size="lg" wide form="draft-form"
                             data-action="click->auth-modal#open" data-auth-modal-intent-param="draft">
                    <twig:Icon name="bookmark" class="h-5 w-5" /> Zapisz jako szkic
                </twig:Button>
            </div>
            <p class="mt-4 text-xs text-zinc-400">Publikując, akceptujesz regulamin Bookly.</p>
        </div>
    </div>
    {% if app.user is null %}
        {# In-page auth modal — no navigation away, the wizard stays filled in. #}
        <div data-auth-modal-target="modal" data-action="click->auth-modal#backdrop"
             class="fixed inset-0 z-50 hidden items-center justify-center bg-zinc-900/60 p-4">
            <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-2xl bg-white p-6 shadow-2xl sm:p-7">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-zinc-900">Jeszcze jeden krok</h3>
                        <p class="mt-1 text-sm text-zinc-500">Zaloguj się lub załóż konto, aby dokończyć. Twój formularz pozostaje wypełniony.</p>
                    </div>
                    <button type="button" data-action="auth-modal#close" class="shrink-0 text-zinc-400 hover:text-zinc-600" aria-label="Zamknij">
                        <twig:Icon name="x" class="h-5 w-5" />
                    </button>
                </div>

                <div class="mt-5 grid grid-cols-2 gap-1 rounded-xl bg-zinc-100 p-1 text-sm font-semibold">
                    <button type="button" data-auth-modal-target="loginTab" data-action="auth-modal#showLogin" class="rounded-lg bg-white px-3 py-2 text-accent-700 shadow-sm">Zaloguj się</button>
                    <button type="button" data-auth-modal-target="registerTab" data-action="auth-modal#showRegister" class="rounded-lg px-3 py-2 text-zinc-500">Załóż konto</button>
                </div>

                {# Same shared forms as the login/register pages — options never diverge. #}
                <div data-auth-modal-target="loginPanel" class="mt-6">
                    <p class="mb-3 text-sm text-error-600 empty:hidden" data-auth-modal-target="loginError"></p>
                    <twig:Auth:LoginForm :loginPath="path('app_login')" :formAttributes="{ 'data-action': 'submit->auth-modal#submitLogin' }" />
                </div>
                <div data-auth-modal-target="registerPanel" class="mt-6 hidden">
                    <p class="mb-3 text-sm text-error-600 empty:hidden" data-auth-modal-target="registerError"></p>
                    <twig:Auth:RegisterForm :registerPath="path('app_register')" :formAttributes="{ 'data-action': 'submit->auth-modal#submitRegister' }" />
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block flow_actions %}
    <twig:Button href="{{ path('app_publish_ebook', { step: 3 }) }}" variant="outline">
        <twig:Icon name="arrow-left" class="h-5 w-5" /> Wstecz
    </twig:Button>
    <twig:Button type="submit" variant="primary" size="lg" form="publish-form"
                 data-action="click->auth-modal#open" data-auth-modal-intent-param="publish">
        <twig:Icon name="cloud-upload" class="h-5 w-5" /> Opublikuj eBook
    </twig:Button>
{% endblock %}
