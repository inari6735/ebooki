{% extends 'dashboard/layout.html.twig' %}

{% block title %}Zakupione — Bookly{% endblock %}

{% set statusMeta = {
    'fulfilled': { label: 'Zrealizowane',  class: 'bg-success-50 text-success-700' },
    'paid':      { label: 'Przetwarzanie', class: 'bg-blue-100 text-blue-700' },
    'refunded':  { label: 'Zwrócone',      class: 'bg-purple-100 text-purple-700' },
} %}

{% block panel_content %}
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Zakupione</h1>
        <p class="mt-1 text-sm text-zinc-500">Twoje zakupione eBooki — pobieraj je kiedy chcesz.</p>
    </div>

    {% if purchases is empty %}
        <div class="mt-6 flex flex-col items-center rounded-3xl border border-dashed border-zinc-200 bg-white px-6 py-16 text-center">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
                <twig:Icon name="cart" class="h-7 w-7" />
            </span>
            <p class="mt-4 text-base font-semibold text-zinc-900">Nie masz jeszcze żadnych zakupów</p>
            <p class="mt-1 max-w-sm text-sm text-zinc-500">Znajdź coś dla siebie w naszej ofercie i wróć tu po swoje tytuły.</p>
            <twig:Button href="{{ path('app_ebooks') }}" variant="primary" size="lg" class="mt-6">
                <twig:Icon name="search" class="h-5 w-5" /> Przeglądaj eBooki
            </twig:Button>
        </div>
    {% else %}
        <div class="mt-6 grid grid-cols-2 gap-x-5 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
            {% for p in purchases %}
                {% set meta = statusMeta[p.status] ?? { label: p.status, class: 'bg-zinc-100 text-zinc-600' } %}
                <twig:Ebook:Tile size="md" :ebook="{
                    id: p.ebook_id, slug: p.ebook_slug, title: p.title, author: p.author_name,
                    category: p.category_name, hasCover: p.cover_media_id is not null, shortDescription: p.short_description,
                }">
                    <twig:block name="badge">
                        <span class="absolute left-3 top-3 z-10 rounded-full px-2.5 py-0.5 text-xs font-semibold shadow-sm {{ meta.class }}">{{ meta.label }}</span>
                    </twig:block>
                    <twig:block name="footer">
                        <div class="mt-2.5">
                            {% if p.status == 'fulfilled' %}
                                <twig:Button href="{{ path('app_download', { ebookId: p.ebook_id }) }}" variant="primary" size="md" wide>
                                    <twig:Icon name="cloud-upload" class="h-4 w-4 rotate-180" /> Pobierz
                                </twig:Button>
                            {% elseif p.status == 'refunded' %}
                                <p class="py-1.5 text-center text-sm text-zinc-400">Dostęp odebrany</p>
                            {% else %}
                                <p class="py-1.5 text-center text-sm text-blue-600">Przetwarzanie…</p>
                            {% endif %}
                        </div>
                    </twig:block>
                </twig:Ebook:Tile>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
