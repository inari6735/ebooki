{% extends 'dashboard/layout.html.twig' %}

{% block title %}Wystawione eBooki — Bookly{% endblock %}

{% set statusMeta = {
    'published':      { label: 'Opublikowany', class: 'bg-success-50 text-success-700' },
    'draft':          { label: 'Szkic',        class: 'bg-zinc-100 text-zinc-600' },
    'pending_review': { label: 'W recenzji',   class: 'bg-accent-50 text-accent-700' },
    'unpublished':    { label: 'Ukryty',       class: 'bg-zinc-100 text-zinc-600' },
    'rejected':       { label: 'Odrzucony',    class: 'bg-error-50 text-error-700' },
} %}

{% set tabs = [
    { key: 'all',         label: 'Wszystkie' },
    { key: 'published',   label: 'Opublikowane' },
    { key: 'draft',       label: 'Szkice' },
    { key: 'unpublished', label: 'Ukryte' },
] %}

{% block panel_content %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Wystawione eBooki</h1>
            <p class="mt-1 text-sm text-zinc-500">Zarządzaj swoimi publikacjami — ukryj, opublikuj lub usuń.</p>
        </div>
        <twig:Button href="{{ path('app_publish_ebook') }}" variant="primary" size="lg">
            <twig:Icon name="cloud-upload" class="h-5 w-5" /> Wystaw eBook
        </twig:Button>
    </div>

    {# Filter tabs #}
    <div class="mt-6 flex gap-1 overflow-x-auto rounded-xl bg-white p-1 shadow-sm ring-1 ring-zinc-100">
        {% for t in tabs %}
            <a href="{{ path('app_dashboard_listed', { status: t.key }) }}"
               class="flex shrink-0 items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition-colors {{ filter == t.key ? 'bg-accent-600 text-white' : 'text-zinc-600 hover:bg-zinc-50' }}">
                {{ t.label }}
                <span class="rounded-full px-1.5 py-0.5 text-xs {{ filter == t.key ? 'bg-white/20 text-white' : 'bg-zinc-100 text-zinc-500' }}">{{ counts[t.key] }}</span>
            </a>
        {% endfor %}
    </div>

    {# List #}
    <div class="mt-6 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-zinc-100 sm:p-6">
        {% if ebooks is empty %}
            <div class="flex flex-col items-center rounded-2xl border border-dashed border-zinc-200 px-6 py-14 text-center">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
                    <twig:Icon name="book" class="h-7 w-7" />
                </span>
                {% if counts.all == 0 %}
                    <p class="mt-4 text-base font-semibold text-zinc-900">Nie masz jeszcze żadnych eBooków</p>
                    <p class="mt-1 max-w-sm text-sm text-zinc-500">Wystaw swój pierwszy eBook — trafi do tysięcy czytelników.</p>
                    <twig:Button href="{{ path('app_publish_ebook') }}" variant="primary" size="lg" class="mt-6">
                        <twig:Icon name="cloud-upload" class="h-5 w-5" /> Wystaw pierwszego eBooka
                    </twig:Button>
                {% else %}
                    <p class="mt-4 text-base font-semibold text-zinc-900">Brak eBooków w tej kategorii</p>
                    <p class="mt-1 text-sm text-zinc-500">Zmień filtr, aby zobaczyć pozostałe publikacje.</p>
                {% endif %}
            </div>
        {% else %}
            <div class="divide-y divide-zinc-100">
                {% for e in ebooks %}
                    {% set st = statusMeta[e.status.value] ?? { label: e.status.value, class: 'bg-zinc-100 text-zinc-600' } %}
                    <div class="flex flex-col gap-4 py-4 lg:flex-row lg:items-center">
                        <twig:Ebook:Cover title="{{ e.title }}" width="w-14" />

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <p class="truncate font-semibold text-zinc-900">{{ e.title }}</p>
                                <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold {{ st.class }}">{{ st.label }}</span>
                            </div>
                            <p class="mt-0.5 truncate text-sm text-zinc-500">{{ e.authorName }}{% if e.category %} · {{ e.category.name }}{% endif %}</p>
                            <p class="mt-0.5 text-xs text-zinc-400">
                                Dodano {{ e.createdAt|date('d.m.Y') }} ·
                                {% if e.pricing.isFree %}Za darmo{% elseif e.pricing.isPayWhatYouWant %}Zapłać ile chcesz{% else %}{{ e.pricing.currentPrice.format }}{% endif %}
                            </p>
                        </div>

                        {# Actions #}
                        <div class="flex flex-wrap items-center gap-2 lg:justify-end">
                            <a href="{{ path('app_ebook_show', { slug: e.slug }) }}" class="inline-flex items-center gap-1.5 rounded-ui border border-zinc-200 bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">
                                <twig:Icon name="eye" class="h-4 w-4" /> Podgląd
                            </a>
                            <a href="{{ path('app_ebook_edit', { id: e.id }) }}" class="inline-flex items-center gap-1.5 rounded-ui border border-zinc-200 bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">
                                <twig:Icon name="edit" class="h-4 w-4" /> Edytuj
                            </a>

                            <form method="post" action="{{ path('app_ebook_toggle_visibility', { id: e.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ebook_manage') }}">
                                {% if e.status.value == 'published' %}
                                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-ui border border-zinc-200 bg-white px-3 py-1.5 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-50">
                                        <twig:Icon name="eye-off" class="h-4 w-4" /> Ukryj
                                    </button>
                                {% else %}
                                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-ui border border-accent-600 bg-white px-3 py-1.5 text-sm font-semibold text-accent-600 transition-colors hover:bg-accent-50">
                                        <twig:Icon name="cloud-upload" class="h-4 w-4" /> Opublikuj
                                    </button>
                                {% endif %}
                            </form>

                            <form method="post" action="{{ path('app_ebook_delete', { id: e.id }) }}" data-turbo-confirm="Na pewno usunąć „{{ e.title }}"? Tej operacji nie można cofnąć.">
                                <input type="hidden" name="_token" value="{{ csrf_token('ebook_manage') }}">
                                <button type="submit" class="inline-flex items-center gap-1.5 rounded-ui border border-zinc-200 bg-white px-3 py-1.5 text-sm font-semibold text-error-600 transition-colors hover:border-error-200 hover:bg-error-50" aria-label="Usuń">
                                    <twig:Icon name="trash" class="h-4 w-4" /> Usuń
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
