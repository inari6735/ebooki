{% extends 'dashboard/layout.html.twig' %}

{% block title %}Pulpit — Bookly{% endblock %}

{% set stats = [
    { icon: 'book',         label: 'Wystawione eBooki', value: totalCount,     tone: 'accent' },
    { icon: 'cloud-upload', label: 'Opublikowane',      value: publishedCount, tone: 'plain' },
    { icon: 'edit',         label: 'Szkice',            value: draftCount,     tone: 'plain' },
    { icon: 'cart',         label: 'Sprzedaż',          value: null,           tone: 'soon' },
] %}

{% set statusMeta = {
    'published':      { label: 'Opublikowany', class: 'bg-success-50 text-success-700' },
    'draft':          { label: 'Szkic',        class: 'bg-zinc-100 text-zinc-600' },
    'pending_review': { label: 'W recenzji',   class: 'bg-accent-50 text-accent-700' },
    'unpublished':    { label: 'Ukryty',       class: 'bg-zinc-100 text-zinc-600' },
    'rejected':       { label: 'Odrzucony',    class: 'bg-error-50 text-error-700' },
} %}

{% set shortcuts = [
    { icon: 'cloud-upload', title: 'Wystaw eBook',     text: 'Dodaj nową publikację w kilka minut.',  href: path('app_publish_ebook') },
    { icon: 'book',         title: 'Wystawione eBooki', text: 'Zarządzaj swoimi publikacjami.',        href: path('app_dashboard_listed') },
    { icon: 'cart',         title: 'Zakupione',         text: 'Wróć do kupionych tytułów.',            href: path('app_dashboard_purchased') },
    { icon: 'search',       title: 'Odkrywaj ofertę',   text: 'Przeglądaj eBooki innych twórców.',     href: path('app_ebooks') },
    { icon: 'settings',     title: 'Ustawienia konta',  text: 'Dane, hasło i preferencje.',            href: '#' },
] %}

{% block panel_content %}
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Pulpit</h1>
            <p class="mt-1 text-sm text-zinc-500">Przegląd Twojego konta w jednym miejscu.</p>
        </div>
        <twig:Button href="{{ path('app_publish_ebook') }}" variant="primary" size="lg">
            <twig:Icon name="cloud-upload" class="h-5 w-5" /> Wystaw eBook
        </twig:Button>
    </div>

    {# General stats #}
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {% for s in stats %}
            <div class="relative rounded-2xl bg-white p-5 shadow-sm ring-1 ring-zinc-100">
                {% if s.tone == 'soon' %}<span class="absolute right-4 top-4 rounded-full bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-400">Wkrótce</span>{% endif %}
                <div class="flex items-center gap-2 {{ s.tone == 'accent' ? 'text-accent-600' : (s.tone == 'soon' ? 'text-zinc-400' : 'text-zinc-500') }}">
                    <twig:Icon name="{{ s.icon }}" class="h-5 w-5" />
                    <span class="text-sm font-medium {{ s.tone == 'soon' ? 'text-zinc-400' : 'text-zinc-500' }}">{{ s.label }}</span>
                </div>
                <p class="mt-3 text-3xl font-extrabold {{ s.tone == 'soon' ? 'text-zinc-300' : 'text-zinc-900' }}">{{ s.value is null ? '—' : s.value }}</p>
            </div>
        {% endfor %}
    </div>

    {# Shortcuts #}
    <h2 class="mt-8 text-lg font-bold text-zinc-900">Szybkie akcje</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {% for a in shortcuts %}
            <a href="{{ a.href }}" class="group flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-zinc-100 transition-shadow hover:shadow-md">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
                    <twig:Icon name="{{ a.icon }}" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                    <p class="font-semibold text-zinc-900">{{ a.title }}</p>
                    <p class="mt-0.5 text-sm text-zinc-500">{{ a.text }}</p>
                </div>
                <twig:Icon name="arrow-right" class="h-5 w-5 shrink-0 text-zinc-300 transition-colors group-hover:text-accent-600" />
            </a>
        {% endfor %}
    </div>

    {# Listed eBooks #}
    <div class="mt-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-zinc-100 lg:p-8">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-zinc-900">Wystawione eBooki</h2>
            {% if ebooks is not empty %}<span class="text-sm text-zinc-400">{{ ebooks|length }} {{ ebooks|length == 1 ? 'pozycja' : 'pozycji' }}</span>{% endif %}
        </div>

        {% if ebooks is empty %}
            <div class="mt-6 flex flex-col items-center rounded-2xl border border-dashed border-zinc-200 px-6 py-12 text-center">
                <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-50 text-accent-600">
                    <twig:Icon name="book" class="h-7 w-7" />
                </span>
                <p class="mt-4 text-base font-semibold text-zinc-900">Nie masz jeszcze żadnych eBooków</p>
                <p class="mt-1 max-w-sm text-sm text-zinc-500">Wystaw swój pierwszy eBook — zajmie to tylko kilka minut, a trafi do tysięcy czytelników.</p>
                <twig:Button href="{{ path('app_publish_ebook') }}" variant="primary" size="lg" class="mt-6">
                    <twig:Icon name="cloud-upload" class="h-5 w-5" /> Wystaw pierwszego eBooka
                </twig:Button>
            </div>
        {% else %}
            <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
                {% for e in ebooks %}
                    {% set st = statusMeta[e.status.value] ?? { label: e.status.value, class: 'bg-zinc-100 text-zinc-600' } %}
                    <twig:Ebook:Tile size="sm" :ebook="{
                        id: e.id, slug: e.slug, title: e.title, author: e.authorName,
                        hasCover: e.cover is not null, shortDescription: e.shortDescription,
                        thumbnails: e.cover ? (coverThumbs[e.cover.id.toRfc4122] ?? []) : [],
                        isFree: e.pricing.isFree, payWhatYouWant: e.pricing.isPayWhatYouWant,
                        price: e.pricing.baseAmountMinor is not null ? e.pricing.baseAmountMinor / 100 : null,
                        promoPrice: e.pricing.promoAmountMinor is not null ? e.pricing.promoAmountMinor / 100 : null,
                    }">
                        <twig:block name="badge">
                            <span class="absolute left-2.5 top-2.5 z-10 rounded-full px-2 py-0.5 text-[11px] font-semibold shadow-sm {{ st.class }}">{{ st.label }}</span>
                        </twig:block>
                    </twig:Ebook:Tile>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
