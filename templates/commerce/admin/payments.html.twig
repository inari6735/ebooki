{% extends 'base.html.twig' %}

{% block title %}Płatności · Panel admina{% endblock %}

{% set statuses = {
    '': 'Wszystkie',
    pending: 'Oczekujące',
    awaiting_payment: 'W trakcie płatności',
    paid: 'Opłacone',
    fulfilled: 'Zrealizowane',
    failed: 'Nieudane',
    refunded: 'Zwrócone',
} %}

{% block body %}
    <div class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-2xl font-extrabold text-zinc-900">Płatności</h1>
            <a href="{{ path('app_admin_reconciliation') }}" class="text-sm font-semibold text-accent-600 hover:text-accent-700">Reconciliation →</a>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            {% for value, label in statuses %}
                <a href="{{ path('app_admin_payments', value ? { status: value } : {}) }}"
                   class="rounded-full px-3.5 py-1.5 text-sm font-medium {{ (status ?? '') == value ? 'bg-accent-600 text-white' : 'bg-white text-zinc-600 ring-1 ring-zinc-200 hover:bg-zinc-50' }}">
                    {{ label }}
                </a>
            {% endfor %}
        </div>

        <div class="mt-6 overflow-x-auto rounded-2xl bg-white ring-1 ring-zinc-100">
            <table class="min-w-full divide-y divide-zinc-100 text-sm">
                <thead class="bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">
                    <tr>
                        <th class="px-4 py-3">Data</th>
                        <th class="px-4 py-3">eBook</th>
                        <th class="px-4 py-3">Kupujący</th>
                        <th class="px-4 py-3 text-right">Kwota</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Metoda</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-50">
                    {% for o in orders %}
                        <tr class="hover:bg-zinc-50/60">
                            <td class="whitespace-nowrap px-4 py-3 text-zinc-500">{{ o.placed_at|date('Y-m-d H:i') }}</td>
                            <td class="px-4 py-3 font-medium text-zinc-800">{{ o.title }}</td>
                            <td class="px-4 py-3 text-zinc-500">{{ o.buyer_email ?? o.buyer_id }}</td>
                            <td class="whitespace-nowrap px-4 py-3 text-right font-semibold text-zinc-800">{{ (o.total_amount / 100)|number_format(2, ',', ' ') }} {{ o.currency }}</td>
                            <td class="px-4 py-3"><twig:Commerce:Admin:StatusBadge status="{{ o.status }}" /></td>
                            <td class="px-4 py-3 text-zinc-500">{{ o.method ?? '—' }}</td>
                            <td class="px-4 py-3 text-right">
                                <a href="{{ path('app_admin_payment_detail', { orderId: o.id }) }}" class="font-semibold text-accent-600 hover:text-accent-700">Szczegóły</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="px-4 py-10 text-center text-zinc-400">Brak płatności do wyświetlenia.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
