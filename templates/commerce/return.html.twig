{% extends 'base.html.twig' %}

{% block title %}Status płatności · Bookly{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-16 text-center sm:px-6">
        {% if paid %}
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-success-50 text-success-600">
                <twig:Icon name="check" class="h-8 w-8" />
            </div>
            <h1 class="mt-6 text-2xl font-extrabold text-zinc-900">Dziękujemy za zakup!</h1>
            <p class="mt-2 text-zinc-500">Płatność za „{{ title }}" została potwierdzona. Dostęp znajdziesz w panelu w sekcji „Zakupione".</p>
            <twig:Button href="{{ path('app_home') }}" variant="primary" size="lg" class="mt-8">Przejdź do biblioteki</twig:Button>
        {% elseif failed %}
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-error-50 text-error-600">
                <twig:Icon name="x" class="h-8 w-8" />
            </div>
            <h1 class="mt-6 text-2xl font-extrabold text-zinc-900">Płatność nie doszła do skutku</h1>
            <p class="mt-2 text-zinc-500">Transakcja za „{{ title }}" nie została zrealizowana. Możesz spróbować ponownie.</p>
            <twig:Button href="{{ path('app_home') }}" variant="outline" size="lg" class="mt-8">Wróć do sklepu</twig:Button>
        {% else %}
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                <twig:Icon name="clock" class="h-8 w-8" />
            </div>
            <h1 class="mt-6 text-2xl font-extrabold text-zinc-900">Przetwarzamy płatność…</h1>
            <p class="mt-2 text-zinc-500">Potwierdzenie za „{{ title }}" może potrwać chwilę. Ta strona zaktualizuje status automatycznie.</p>
            <p class="mt-6 text-sm text-zinc-400">Nie zamykaj tej strony — odświeżamy status co kilka sekund.</p>
        {% endif %}
    </div>

    {% if not paid and not failed %}
        {# UX-only auto refresh while the async confirmation lands; the webhook is the source of truth. #}
        <meta http-equiv="refresh" content="4">
    {% endif %}
{% endblock %}
