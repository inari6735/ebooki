{# "How you get the eBook" — native re-implementation of the delivery infographic:
   three equal-height step cards, each with a mini UI mockup, linked by arrows. #}
<section class="rounded-3xl bg-[#f8f8fd] px-4 py-12 sm:px-8 sm:py-14">
    <h2 class="text-center text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl">Jak otrzymasz swojego eBooka?</h2>
    <div class="mt-4 flex items-center justify-center gap-3 text-sm font-semibold text-accent-600">
        <span class="h-px w-10 bg-accent-200"></span>
        <span class="h-1 w-1 rounded-full bg-accent-500"></span>
        <span>3 proste kroki</span>
        <span class="h-1 w-1 rounded-full bg-accent-500"></span>
        <span class="h-px w-10 bg-accent-200"></span>
    </div>

    <div class="mt-10 grid items-stretch gap-y-5 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:gap-x-4">
        {# ── Step 1 — Kup eBooka ───────────────────────────────────────── #}
        <div class="flex h-full flex-col rounded-3xl bg-white p-6 shadow-sm ring-1 ring-zinc-100 sm:p-7">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-600 text-lg font-bold text-white">1</span>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                    <twig:Icon name="cart" class="h-6 w-6" />
                </span>
                <div class="min-w-0">
                    <p class="text-lg font-bold leading-tight text-zinc-900">Kup eBooka</p>
                    <p class="mt-1 text-sm leading-snug text-zinc-500">Wybierz interesujący Cię tytuł i dodaj go do koszyka.</p>
                </div>
            </div>

            <div class="mt-6 flex flex-1 flex-col rounded-2xl border border-zinc-100 bg-white p-5 shadow-sm">
                <div class="flex gap-4">
                    <div class="flex aspect-cover w-24 shrink-0 flex-col items-center justify-center rounded-xl bg-gradient-to-b from-accent-100 to-accent-200 p-2.5 text-center shadow-sm ring-1 ring-accent-900/5">
                        <span class="text-[10px] font-bold uppercase leading-tight text-accent-800">Skuteczna produktywność</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="inline-flex items-center rounded-full bg-accent-50 px-2.5 py-0.5 text-xs font-semibold text-accent-700">eBook PDF</span>
                        <p class="mt-2 text-base font-bold leading-snug text-zinc-900">Skuteczna produktywność</p>
                        <p class="text-sm text-zinc-400">Anna Kowalska</p>
                        <div class="mt-1.5 flex items-center gap-1.5 text-sm">
                            <twig:Icon name="star" class="h-4 w-4 fill-current text-rating" />
                            <span class="font-semibold text-zinc-900">4,9</span>
                            <span class="text-zinc-400">(326 ocen)</span>
                        </div>
                    </div>
                </div>

                <div class="mt-5 flex items-end justify-between border-t border-zinc-100 pt-4">
                    <div>
                        <p class="text-2xl font-extrabold leading-none text-accent-600">29,99 zł</p>
                        <p class="mt-1 text-xs text-zinc-400">Cena zawiera VAT</p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-success-50 px-3 py-1 text-xs font-semibold text-success-700">
                        <twig:Icon name="check" class="h-3.5 w-3.5" /> Dostęp natychmiastowy
                    </span>
                </div>

                <div class="mt-auto pt-5">
                    <div class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent-600 py-3 text-base font-semibold text-white">
                        <twig:Icon name="cart" class="h-5 w-5" /> Dodaj do koszyka
                    </div>
                </div>
            </div>
        </div>

        <div class="hidden items-center justify-center lg:flex" aria-hidden="true">
            <twig:Icon name="arrow-right" class="h-8 w-8 text-accent-500" />
        </div>

        {# ── Step 2 — Opłać zamówienie ─────────────────────────────────── #}
        <div class="flex h-full flex-col rounded-3xl bg-white p-6 shadow-sm ring-1 ring-zinc-100 sm:p-7">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-600 text-lg font-bold text-white">2</span>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                    <twig:Icon name="credit-card" class="h-6 w-6" />
                </span>
                <div class="min-w-0">
                    <p class="text-lg font-bold leading-tight text-zinc-900">Opłać zamówienie</p>
                    <p class="mt-1 text-sm leading-snug text-zinc-500">Wybierz metodę płatności i potwierdź zakup.</p>
                </div>
            </div>

            <div class="mt-6 flex flex-1 flex-col rounded-2xl border border-zinc-100 bg-white p-5 shadow-sm">
                <p class="text-base font-bold text-zinc-900">Wybierz metodę płatności</p>
                <div class="mt-4 space-y-2.5">
                    <div class="flex items-center gap-3 rounded-xl border border-accent-600 bg-accent-50/60 p-3.5">
                        <span class="relative h-5 w-5 shrink-0 rounded-full border-2 border-accent-600">
                            <span class="absolute inset-[3px] rounded-full bg-accent-600"></span>
                        </span>
                        <span class="flex-1 text-sm font-semibold text-zinc-800">Karta płatnicza</span>
                        <span class="text-sm font-black italic text-[#1a1f71]">VISA</span>
                        <span class="flex"><span class="h-5 w-5 rounded-full bg-[#eb001b]"></span><span class="-ml-2.5 h-5 w-5 rounded-full bg-[#f79e1b] opacity-90"></span></span>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-zinc-200 p-3.5">
                        <span class="h-5 w-5 shrink-0 rounded-full border-2 border-zinc-300"></span>
                        <span class="flex-1 text-sm font-semibold text-zinc-700">BLIK</span>
                        <span class="rounded bg-zinc-900 px-2 py-0.5 text-xs font-bold text-white">blik</span>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-zinc-200 p-3.5">
                        <span class="h-5 w-5 shrink-0 rounded-full border-2 border-zinc-300"></span>
                        <span class="flex-1 text-sm font-semibold text-zinc-700">Przelew online</span>
                        <twig:Icon name="bank" class="h-6 w-6 text-zinc-500" />
                    </div>
                </div>
                <div class="mt-auto pt-5">
                    <div class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent-600 py-3 text-base font-semibold text-white">
                        <twig:Icon name="lock" class="h-5 w-5" /> Zapłać 29,99 zł
                    </div>
                    <p class="mt-3 flex items-center justify-center gap-1.5 text-sm text-zinc-400">
                        <twig:Icon name="shield" class="h-4 w-4" /> Płatność jest bezpieczna
                    </p>
                </div>
            </div>
        </div>

        <div class="hidden items-center justify-center lg:flex" aria-hidden="true">
            <twig:Icon name="arrow-right" class="h-8 w-8 text-accent-500" />
        </div>

        {# ── Step 3 — Sprawdź e-mail ───────────────────────────────────── #}
        <div class="flex h-full flex-col rounded-3xl bg-white p-6 shadow-sm ring-1 ring-zinc-100 sm:p-7">
            <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-600 text-lg font-bold text-white">3</span>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent-50 text-accent-600">
                    <twig:Icon name="mail" class="h-6 w-6" />
                </span>
                <div class="min-w-0">
                    <p class="text-lg font-bold leading-tight text-zinc-900">Sprawdź e-mail</p>
                    <p class="mt-1 text-sm leading-snug text-zinc-500">Odbierz link do pobrania swojego eBooka.</p>
                </div>
            </div>

            <div class="mt-6 flex flex-1 flex-col rounded-2xl border border-zinc-100 bg-white p-4 shadow-sm">
                <div class="flex items-center border-b border-zinc-100 pb-3 text-zinc-400">
                    <twig:Icon name="arrow-left" class="h-5 w-5" />
                    <span class="ml-auto flex items-center gap-3.5">
                        <twig:Icon name="download" class="h-5 w-5" />
                        <twig:Icon name="trash" class="h-5 w-5" />
                        <twig:Icon name="mail" class="h-5 w-5" />
                        <twig:Icon name="more-vert" class="h-5 w-5" />
                    </span>
                </div>
                <div class="mt-4 flex items-center gap-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-600 text-white">
                        <twig:Icon name="book" class="h-5 w-5" />
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm font-bold leading-tight text-zinc-900">Bookly</p>
                        <p class="text-xs text-zinc-400">do Ciebie</p>
                    </div>
                    <span class="ml-auto text-xs text-zinc-400">10:24</span>
                </div>
                <div class="mt-4 flex flex-1 flex-col justify-center rounded-xl bg-accent-50 p-5 text-center">
                    <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-accent-600 text-white">
                        <twig:Icon name="check" class="h-6 w-6" />
                    </span>
                    <p class="mt-3 text-base font-bold text-zinc-900">Dziękujemy za zakup!</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-zinc-500">Twój eBook jest gotowy do pobrania. Kliknij w poniższy link, aby pobrać plik.</p>
                    <div class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent-600 py-3 text-base font-semibold text-white">
                        <twig:Icon name="download" class="h-5 w-5" /> Pobierz eBooka
                    </div>
                    <p class="mt-2.5 text-xs text-zinc-400">Link ważny przez 7 dni.</p>
                </div>
            </div>
        </div>
    </div>
</section>
