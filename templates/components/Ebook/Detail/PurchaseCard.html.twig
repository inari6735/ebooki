{% props ebook %}

{% set perks = [
    { icon: 'lightning', text: 'Natychmiastowa dostawa' },
    { icon: 'clock',     text: 'Dostęp na zawsze' },
    { icon: 'monitor',   text: 'Czytaj na dowolnym urządzeniu' },
] %}

<div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-zinc-100 sm:p-7">
    <div class="flex items-center justify-between">
        <p class="text-sm font-semibold text-zinc-800">Cena eBooka</p>
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-500">
            <twig:Icon name="shield" class="h-4 w-4 text-accent-600" />
            Bezpieczne zakupy
        </span>
    </div>

    {% set isFree = ebook.isFree ?? false %}
    {% set pwyw = ebook.payWhatYouWant ?? false %}
    {% set base = ebook.price ?: 0 %}
    {% set promo = ebook.promoPrice ?? null %}
    {% set discounted = not isFree and not pwyw and promo and promo > 0 and promo < base %}
    {% set effective = discounted ? promo : base %}
    {% set discountPct = discounted ? ((base - promo) / base * 100)|round : 0 %}

    {% if isFree %}
        <p class="mt-3 text-4xl font-extrabold text-success-600">Za darmo</p>
        <p class="mt-1 text-sm text-zinc-400">Pobierz bez opłat</p>
    {% elseif pwyw %}
        <p class="mt-3 text-3xl font-extrabold text-accent-600">Zapłać ile chcesz</p>
        <p class="mt-1 text-sm text-zinc-400">Dobrowolna wpłata — Ty decydujesz</p>
    {% else %}
        <div class="mt-3 flex flex-wrap items-baseline gap-2.5">
            <p class="text-4xl font-extrabold text-accent-600">{{ effective|number_format(2, ',', ' ') }} <span class="text-2xl">zł</span></p>
            {% if discounted %}
                <span class="text-lg text-zinc-400 line-through">{{ base|number_format(2, ',', ' ') }} zł</span>
                <span class="rounded-full bg-error-50 px-2 py-0.5 text-xs font-bold text-error-600">-{{ discountPct }}%</span>
            {% endif %}
        </div>
        <p class="mt-1 text-sm text-zinc-400">Cena zawiera VAT</p>
    {% endif %}

    {% if isFree or pwyw %}
        {# Free / pay-what-you-want are not part of the paid-checkout MVP yet. #}
        <twig:Button variant="primary" size="lg" wide class="mt-6">
            {% if isFree %}
                <twig:Icon name="cloud-upload" class="h-5 w-5 rotate-180" /> Pobierz za darmo
            {% else %}
                <twig:Icon name="cart" class="h-5 w-5" /> Zapłać ile chcesz
            {% endif %}
        </twig:Button>
    {% else %}
        {# Real checkout: full-page navigation (data-turbo=false) so the external
           Przelewy24 redirect works; session CSRF (id "checkout", no double-submit). #}
        <form method="post" action="{{ path('app_checkout', { slug: ebook.slug }) }}" data-turbo="false" class="mt-6">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
            <label class="flex items-start gap-2.5 text-xs leading-relaxed text-zinc-500">
                <input type="checkbox" name="withdrawal_consent" value="1" required
                       class="mt-0.5 h-4 w-4 shrink-0 rounded border-zinc-300 text-accent-600 focus:ring-accent-500">
                <span>Wyrażam zgodę na natychmiastowe udostępnienie treści cyfrowej i przyjmuję do wiadomości utratę prawa do odstąpienia od umowy.</span>
            </label>
            <twig:Button type="submit" variant="primary" size="lg" wide class="mt-4">
                <twig:Icon name="cart" class="h-5 w-5" /> Kup teraz
            </twig:Button>
        </form>
    {% endif %}
    <twig:Button variant="outline" size="lg" wide class="mt-3">
        <twig:Icon name="heart" class="h-5 w-5" /> Dodaj do ulubionych
    </twig:Button>

    <ul class="mt-6 space-y-3">
        {% for p in perks %}
            <li class="flex items-center gap-3 text-sm text-zinc-600">
                <twig:Icon name="{{ p.icon }}" class="h-5 w-5 shrink-0 text-accent-600" />
                {{ p.text }}
            </li>
        {% endfor %}
    </ul>

    <div class="mt-6 rounded-2xl bg-accent-50 p-5">
        <p class="inline-flex items-center gap-2 text-sm font-semibold text-accent-700">
            <twig:Icon name="lock" class="h-5 w-5" /> Bezpieczne płatności
        </p>
        <p class="mt-2 text-sm text-zinc-600">Płatności obsługiwane przez zaufanych partnerów. Twoje dane są chronione.</p>
        <twig:Ebook:Detail:PaymentMarks class="mt-4" />
    </div>
</div>
