{% set links = [
    { label: 'Strona główna', href: path('app_home'), active: true },
    { label: 'Kategorie',     href: '#', caret: true },
    { label: 'Bestsellery',   href: '#' },
    { label: 'Najnowsze',     href: '#' },
    { label: 'Jak to działa?',href: '#' },
    { label: 'Dla autorów',   href: '#' },
    { label: 'Promocje',      href: '#' },
] %}

<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white" data-controller="disclosure">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2.5">
            <twig:Icon name="book" class="h-8 w-8 text-accent-600" />
            <span class="text-2xl font-extrabold tracking-tight text-zinc-900">Bookly</span>
        </a>

        <nav class="hidden items-center gap-7 lg:flex">
            {% for l in links %}
                <a href="{{ l.href }}"
                   class="inline-flex items-center gap-1 text-sm {{ l.active|default(false)
                       ? 'border-b-2 border-accent-600 pb-0.5 font-semibold text-accent-600'
                       : 'font-medium text-zinc-600 hover:text-accent-600' }}">
                    {{ l.label }}{% if l.caret|default(false) %}<twig:Icon name="chevron-down" class="h-4 w-4" />{% endif %}
                </a>
            {% endfor %}
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
            <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-accent-600" aria-label="Szukaj">
                <twig:Icon name="search" class="h-5 w-5" />
            </a>

            {% if app.user %}
                <span class="hidden text-sm text-zinc-600 sm:inline">{{ app.user.userIdentifier }}</span>
                <form method="post" action="{{ path('app_logout') }}" class="hidden sm:block">
                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                    <twig:Button type="submit" variant="ghost">Wyloguj</twig:Button>
                </form>
            {% else %}
                <twig:Button href="{{ path('app_login') }}" variant="outline" class="hidden sm:inline-flex">Zaloguj się</twig:Button>
                <twig:Button href="{{ path('app_register') }}" variant="primary" class="hidden sm:inline-flex">Załóż konto</twig:Button>
            {% endif %}

            <button type="button" data-action="disclosure#toggle" aria-label="Menu"
                    class="flex h-10 w-10 items-center justify-center rounded-full text-zinc-600 hover:bg-zinc-100 lg:hidden">
                <twig:Icon name="menu" class="h-6 w-6" />
            </button>
        </div>
    </div>

    {# Mobile panel #}
    <div data-disclosure-target="panel" class="hidden border-t border-zinc-200 bg-white lg:hidden">
        <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-4 py-4 sm:px-6">
            {% for l in links %}
                <a href="{{ l.href }}" class="rounded-ui px-3 py-2 text-sm font-medium {{ l.active|default(false) ? 'bg-accent-50 text-accent-700' : 'text-zinc-600 hover:bg-zinc-50' }}">{{ l.label }}</a>
            {% endfor %}
            <div class="mt-3 flex flex-col gap-2 border-t border-zinc-200 pt-4">
                {% if app.user %}
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                        <twig:Button type="submit" variant="outline" wide>Wyloguj</twig:Button>
                    </form>
                {% else %}
                    <twig:Button href="{{ path('app_login') }}" variant="outline" wide>Zaloguj się</twig:Button>
                    <twig:Button href="{{ path('app_register') }}" variant="primary" wide>Załóż konto</twig:Button>
                {% endif %}
            </div>
        </nav>
    </div>
</header>
