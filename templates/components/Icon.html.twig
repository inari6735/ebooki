{% props name %}

{# Bookly icons — backed by the Lucide set via Symfony UX Icons. This component
   maps our internal, design-system names to Lucide icons (vendored offline under
   assets/icons/lucide/), so every call site stays unchanged and consistent:
       <twig:Icon name="cart" class="h-5 w-5 text-accent-600" />
   Add an icon: `php bin/console ux:icons:import lucide:NAME`, then map it below. #}
{% set map = {
    'arrow-left':   'arrow-left',
    'arrow-right':  'arrow-right',
    'bank':         'landmark',
    'bell':         'bell',
    'book':         'book-open',
    'bookmark':     'bookmark',
    'bulb':         'lightbulb',
    'calendar':     'calendar',
    'cart':         'shopping-cart',
    'chart':        'trending-up',
    'chat':         'message-square',
    'check':        'check',
    'chevron-down': 'chevron-down',
    'clock':        'clock',
    'cloud-upload': 'cloud-upload',
    'credit-card':  'credit-card',
    'download':     'download',
    'edit':         'square-pen',
    'eye':          'eye',
    'eye-off':      'eye-off',
    'globe':        'globe',
    'heart':        'heart',
    'help':         'circle-question-mark',
    'home':         'house',
    'lightning':    'zap',
    'lock':         'lock',
    'mail':         'mail',
    'menu':         'menu',
    'monitor':      'monitor',
    'more-vert':    'ellipsis-vertical',
    'phone':        'phone',
    'plus':         'plus',
    'rocket':       'rocket',
    'search':       'search',
    'settings':     'settings',
    'shield':       'shield-check',
    'sliders':      'sliders-horizontal',
    'star':         'star',
    'tag':          'tag',
    'trash':        'trash-2',
