{% set features = [
    { icon: 'tag',    title: '0% opłat za dodanie',   text: 'Płacisz tylko od sprzedaży' },
    { icon: 'shield', title: 'Bezpieczne transakcje', text: 'Pewne płatności i ochrona' },
    { icon: 'users',  title: 'Tysiące twórców',       text: 'Dołącz do naszej społeczności' },
] %}

<section class="relative -mt-[76px] overflow-hidden bg-gradient-to-tl from-accent-200 via-accent-100 to-white">
    {# Background strongest at the bottom-right, fading out toward the top-left #}
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-28 -right-28 h-[36rem] w-[36rem] rounded-full bg-accent-200/60 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute bottom-4 right-1/4 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-16 top-8 h-72 w-72 rounded-full bg-accent-100 blur-3xl"></div>
    <div aria-hidden="true" class="dot-grid pointer-events-none absolute right-8 top-24 hidden h-40 w-56 text-accent-200 opacity-60 lg:block"></div>

    <div class="relative z-10 mx-auto max-w-[1600px] px-4 pb-44 pt-24 sm:px-6 sm:pb-56 lg:px-8 lg:pt-28">
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-8">
            {# Left — copy #}
            <div>
                <span class="inline-flex items-center gap-2.5 rounded-full bg-gradient-to-b from-white to-accent-50 py-1.5 pl-1.5 pr-4 text-sm font-semibold text-accent-700 shadow-lg shadow-accent-600/10 ring-1 ring-white/80 backdrop-blur">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-accent-500 to-accent-700 text-white shadow-sm shadow-accent-600/30">
                        <twig:Icon name="users" class="h-3.5 w-3.5" />
                    </span>
                    Marketplace dla czytelników i autorów
                </span>

                <h1 class="mt-6 text-4xl font-extrabold leading-[1.08] tracking-tight text-zinc-900 sm:text-5xl xl:text-6xl">
                    Kupuj i <span class="text-accent-600">sprzedawaj</span> eBooki w jednym miejscu
                </h1>

                <p class="mt-5 max-w-xl text-lg leading-relaxed text-zinc-600">
                    Jesteś autorem? Prześlij swojego eBooka, ustaw cenę i zacznij sprzedawać bez zbędnych formalności.
                    Jesteś czytelnikiem? Odkrywaj tysiące tytułów od niezależnych twórców i wydawców.
                </p>

                <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                    <twig:Button href="{{ path('app_publish_ebook') }}" variant="primary" size="lg" class="btn-3d">
                        <twig:Icon name="cloud-upload" class="h-5 w-5" />
                        Wystaw swój eBook
                    </twig:Button>
                    <twig:Button href="#" variant="outline" size="lg" class="bg-white/80 shadow-lg shadow-zinc-900/5 ring-1 ring-white/70 backdrop-blur">
                        Przeglądaj ofertę <twig:Icon name="arrow-right" class="h-5 w-5" />
                    </twig:Button>
                </div>

                <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
                    {% for f in features %}
                        <div class="flex items-center gap-3">
                            <span class="icon-3d flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-accent-600">
                                <twig:Icon name="{{ f.icon }}" class="h-5 w-5" />
                            </span>
                            <span>
                                <span class="block text-sm font-semibold text-zinc-800">{{ f.title }}</span>
                                <span class="block text-sm text-zinc-500">{{ f.text }}</span>
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Right — the product laptop (asset already tilted) #}
            <div class="relative">
                {# Decorative shapes behind the laptop — varied sizes, a weaving curve,
                   accent + yellow accents #}
                <div aria-hidden="true" class="pointer-events-none absolute inset-0">
                    {# large translucent blobs — transparent fill, clearly visible outline #}
                    <span class="absolute left-1/2 top-1/2 h-[26rem] w-[26rem] -translate-x-1/2 -translate-y-1/2 border-2 border-accent-500/35" style="border-radius: 42% 58% 62% 38% / 45% 42% 58% 55%"></span>
                    <span class="absolute -left-16 top-2 h-80 w-80 border-2 border-accent-500/30" style="border-radius: 60% 40% 45% 55% / 55% 45% 60% 40%"></span>
                    <span class="absolute -right-14 bottom-0 h-80 w-80 border-2 border-accent-500/30" style="border-radius: 45% 55% 58% 42% / 48% 52% 45% 55%"></span>
                    <span class="absolute right-16 top-8 h-64 w-64 border-2 border-rating/50" style="border-radius: 55% 45% 42% 58% / 60% 40% 55% 45%"></span>

                    {# soft blobs (big → small) #}
                    <span class="absolute -right-6 -top-2 h-64 w-64 rotate-12 rounded-[42%] bg-accent-200/45 blur-md"></span>
                    <span class="absolute left-1/4 bottom-6 h-44 w-44 -rotate-6 rounded-[46%] bg-accent-100 blur-sm"></span>
                    <span class="absolute right-1/4 top-1/2 h-24 w-24 rounded-[48%] bg-accent-200/40 blur-sm"></span>
                    <span class="absolute left-4 bottom-1/3 h-16 w-16 rounded-[45%] bg-rating/15 blur-sm"></span>
                    {# rings (solid, dashed, small) #}
                    <span class="absolute -left-3 top-1/3 h-20 w-20 rounded-full border-2 border-accent-200"></span>
                    <span class="absolute right-6 bottom-14 h-28 w-28 rounded-full border-2 border-dashed border-accent-200/70"></span>
                    <span class="absolute left-1/2 top-2 h-9 w-9 rounded-full border-2 border-accent-200/60"></span>
                    {# a curved line weaving round shapes #}
                    <svg class="absolute left-0 top-8 h-24 w-56 text-accent-500/40" viewBox="0 0 220 90" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <path d="M8 62 C34 8, 78 8, 104 54 S176 96, 212 40"/>
                    </svg>
                    {# dots — accent + yellow, different sizes #}
                    <span class="absolute right-14 top-6 h-4 w-4 rounded-full bg-accent-500/50"></span>
                    <span class="absolute left-8 top-20 h-2.5 w-2.5 rounded-full bg-accent-500/40"></span>
                    <span class="absolute left-12 bottom-14 h-2 w-2 rounded-full bg-accent-500/60"></span>
                    <span class="absolute right-1/3 bottom-2 h-3 w-3 rounded-full bg-accent-500/40"></span>
                    <span class="absolute right-24 bottom-6 h-4 w-4 rounded-full bg-rating/80"></span>
                    <span class="absolute left-1/3 top-1 h-2.5 w-2.5 rounded-full bg-rating"></span>
                    <span class="absolute right-2 top-1/3 h-2 w-2 rounded-full bg-rating/70"></span>
                    {# sparkles (accent + yellow) #}
                    <svg class="absolute left-0 top-1/2 h-6 w-6 text-accent-500/70" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5 14 9.5 22 12 14 14.5 12 22.5 10 14.5 2 12 10 9.5Z"/></svg>
                    <svg class="absolute right-8 top-3 h-5 w-5 text-rating" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5 14 9.5 22 12 14 14.5 12 22.5 10 14.5 2 12 10 9.5Z"/></svg>
                </div>

                {# Ground contact shadow — static, so the floating laptop reads as hovering in 3D #}
                <div aria-hidden="true" class="pointer-events-none absolute inset-x-14 bottom-1 z-0 h-10 rounded-[50%] bg-zinc-900/25 blur-2xl sm:inset-x-24 sm:h-14"></div>

                <img src="{{ asset('images/home-hero-laptop.png') }}" width="1448" height="1086"
                     alt="Panel autora Bookly na laptopie — Twoje eBooki, sprzedaż i zarobki w jednym miejscu"
                     class="hero-float-slow relative z-10 w-full max-w-2xl lg:max-w-none xl:scale-105">

                {# "Sprzedaż +24%" — floating, tilted, with a strong accent icon chip #}
                <div class="absolute left-0 top-10 z-20 hidden -rotate-6 sm:block lg:-left-4">
                    <div class="hero-float badge-3d flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-5 ring-1 ring-zinc-100 backdrop-blur">
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-accent-500 to-accent-700 text-white shadow-md shadow-accent-600/30">
                            <twig:Icon name="chart" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-xs font-medium text-zinc-500">Sprzedaż (30 dni)</p>
                            <p class="flex items-center gap-1 text-lg font-bold text-zinc-900">+24%
                                <twig:Icon name="arrow-right" class="h-4 w-4 -rotate-45 text-emerald-600" />
                            </p>
                        </div>
                    </div>
                </div>

                {# "eBook opublikowany!" — floating, tilted the other way, strong green chip #}
                <div class="absolute -left-2 bottom-16 z-20 hidden max-w-[15rem] rotate-3 sm:block lg:bottom-24">
                    <div class="hero-float-slow badge-3d flex items-center gap-3 rounded-2xl bg-white/95 p-3 pr-4 ring-1 ring-zinc-100 backdrop-blur">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-emerald-400 to-emerald-600 text-white shadow-md shadow-emerald-500/30">
                            <twig:Icon name="check" class="h-5 w-5" />
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-zinc-900">eBook opublikowany!</p>
                            <p class="text-xs text-zinc-500">Twój eBook jest teraz dostępny w sklepie.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Custom wavy bottom edge (provided design). Flipped vertically so the white
       sits at the bottom and blends into the white section below. #}
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-0">
        <svg viewBox="0 0 1440 490" preserveAspectRatio="none" class="h-[100px] w-full -scale-y-100 sm:h-[190px]">
            <path fill="#ffffff" d="M 0,500 L 0,187 C 80.03023016145656,145.21435932669186 160.06046032291312,103.42871865338371 230,108 C 299.9395396770869,112.57128134661629 359.7883888698041,163.499484713157 423,165 C 486.2116111301959,166.500515286843 552.7859841978701,118.5733424939883 622,107 C 691.2140158021299,95.4266575060117 763.0676743387153,120.20714531088973 820,159 C 876.9323256612847,197.79285468911027 918.9433184472691,250.59807626245274 997,233 C 1075.0566815527309,215.40192373754726 1189.159051872209,127.40054963929923 1269,108 C 1348.840948127791,88.59945036070077 1394.4204740638957,137.79972518035038 1440,187 L 1440,500 L 0,500 Z" transform="rotate(-180 720 250)"></path>
        </svg>
    </div>
</section>
