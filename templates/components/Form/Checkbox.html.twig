{% props name, id = null, label = null, checked = false, disabled = false, value = '1' %}

<label class="inline-flex items-start gap-2.5 text-sm text-zinc-600 {{ disabled ? 'cursor-not-allowed opacity-60' : 'cursor-pointer' }}">
    <input type="checkbox" name="{{ name }}" id="{{ id ?? name }}" value="{{ value }}"
           {% if checked %}checked{% endif %} {% if disabled %}disabled{% endif %}
           class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-accent-600 focus:ring-accent-600/30 disabled:opacity-60">
    <span>{% block content %}{{ label }}{% endblock %}</span>
</label>
