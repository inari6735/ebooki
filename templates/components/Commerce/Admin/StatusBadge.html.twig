{% props status %}

{% set map = {
    pending:          { label: 'Oczekujące',    class: 'bg-zinc-100 text-zinc-600' },
    awaiting_payment: { label: 'W płatności',    class: 'bg-amber-100 text-amber-700' },
    paid:             { label: 'Opłacone',       class: 'bg-blue-100 text-blue-700' },
    fulfilled:        { label: 'Zrealizowane',   class: 'bg-success-50 text-success-600' },
    failed:           { label: 'Nieudane',       class: 'bg-error-50 text-error-600' },
    expired:          { label: 'Wygasłe',        class: 'bg-zinc-100 text-zinc-500' },
    refunded:         { label: 'Zwrócone',       class: 'bg-purple-100 text-purple-700' },
} %}
{% set s = map[status] ?? { label: status, class: 'bg-zinc-100 text-zinc-600' } %}

<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {{ s.class }}">{{ s.label }}</span>
