{% props form, registerPath, loginPath, termsPath = '#' %}

<div class="w-full max-w-md space-y-4">
    <div class="rounded-3xl bg-white p-8 shadow-xl shadow-zinc-900/5 ring-1 ring-zinc-100 sm:p-10">
        <div class="text-center">
            <h2 class="text-3xl font-bold text-zinc-900">Załóż konto</h2>
            <p class="mt-2 text-sm text-zinc-500">Dołącz do Bookly i zacznij już dziś</p>
        </div>

        <div class="mt-7">
            <twig:Auth:RegisterForm :registerPath="registerPath" :form="form" :termsPath="termsPath" />
        </div>

        <p class="mt-6 text-center text-sm text-zinc-600">
            Masz już konto?
            <a href="{{ loginPath }}" class="font-semibold text-accent-600 hover:text-accent-700">Zaloguj się</a>
        </p>
    </div>
</div>
