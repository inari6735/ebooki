{% props backHref = '/' %}

<div class="relative min-h-screen w-full bg-canvas bg-cover bg-center bg-no-repeat"
     style="background-image: url('{{ asset('images/login-bg.png') }}')">
    <div class="flex min-h-screen flex-col px-6 sm:px-10 lg:px-14">
        <header class="flex items-center justify-between py-6 lg:py-8">
            <a href="{{ backHref }}" class="flex items-center gap-2.5">
                <span class="text-accent-600">
                    <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 6.5C10.3 5.2 8 4.5 5.5 4.5c-.9 0-1.8.1-2.6.3-.5.1-.9.6-.9 1.1v11.3c0 .7.7 1.2 1.4 1 .7-.2 1.4-.2 2.1-.2 2 0 3.9.6 5.5 1.7V6.5Z"/>
                        <path d="M12 6.5C13.7 5.2 16 4.5 18.5 4.5c.9 0 1.8.1 2.6.3.5.1.9.6.9 1.1v11.3c0 .7-.7 1.2-1.4 1-.7-.2-1.4-.2-2.1-.2-2 0-3.9.6-5.5 1.7V6.5Z" opacity=".55"/>
                    </svg>
                </span>
                <span class="text-2xl font-extrabold tracking-tight text-zinc-900">Bookly</span>
            </a>

            <a href="{{ backHref }}" class="inline-flex items-center gap-2 text-sm font-semibold text-accent-600 hover:text-accent-700">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
                <span class="hidden sm:inline">Powrót na stronę główną</span>
            </a>
        </header>

        <div class="grid flex-1 items-center gap-10 pb-12 lg:grid-cols-2 lg:gap-16">
            <div class="relative hidden h-full self-stretch lg:block">
                <div class="flex justify-center pt-4">
                    {% block brand %}{% endblock %}
                </div>
                {# Illustration anchored to the bottom-right of the full-height column.
                   `relative` is on THIS column (not the text block), so bottom/right
                   resolve against the whole left side. #}
                <img src="{{ asset('images/login-brand.png') }}" alt=""
                     class="pointer-events-none absolute bottom-0 right-0 w-full max-w-2xl translate-x-[100px] object-contain">
            </div>
            <div class="flex w-full justify-center">
                {% block form %}{% endblock %}
            </div>
        </div>
    </div>
</div>
