{% extends 'base.html.twig' %}

{% block title %}Zaloguj się · Bookly{% endblock %}

{% block shell %}
    <twig:Auth:Shell backHref="{{ path('app_home') }}" backgroundImage="{{ asset('images/login-bg.png') }}">
        <twig:block name="brand">
            <twig:Auth:BrandPanel
                badge="Marketplace dla czytelników i autorów"
                heading="Witaj ponownie w Bookly"
                subtitle="Zaloguj się, aby kupować eBooki, zarządzać swoją biblioteką i sprzedawać własne publikacje."
            />
        </twig:block>

        <twig:block name="illustration">
            <twig:Auth:Illustration src="{{ asset('images/login-brand.png') }}" position="right" />
        </twig:block>

        <twig:block name="form">
            <twig:Auth:LoginCard
                loginPath="{{ path('app_login') }}"
                registerPath="{{ path('app_register', target_path ? { _target_path: target_path } : {}) }}"
                targetPath="{{ target_path }}"
            />
        </twig:block>
    </twig:Auth:Shell>
{% endblock %}
